# Editor / OS junk
*.swp
*.swo
*.DS_Store

# Bundler
/.bundle
/vendor/bundle

# Node modules
/node_modules

# Environment & credentials
.env*
/config/master.key
/config/credentials.yml.enc

# Logs / tmp
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Storage (uploads in dev)
/storage/*
!/storage/.keep

# Compiled assets
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep

# Debug
/.byebug_history
test.wav

# Vite Ruby
/public/vite*
node_modules
# Vite uses dotenv and suggests to ignore local-only env files. See
# https://vitejs.dev/guide/env-and-mode.html#env-files
*.local

db/seed_assets/audio/*.mp3
