<%= turbo_stream_from "user_#{current_user.id}_dashboard" %>

<!-- Audio Player Modal (Hidden by default) -->
<div id="audioModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 rounded-2xl shadow-2xl max-w-4xl w-full p-8 border border-white/20 relative">
    <!-- Close Button -->
    <button onclick="closeAudioModal()" class="absolute top-4 right-4 text-white/60 hover:text-white text-3xl">&times;</button>
    
    <!-- Reflection Title -->
    <h2 id="modalTitle" class="text-3xl font-bold tracking-wider text-white text-center mb-8">Loading...</h2>
    
    <!-- Large Play/Pause Button -->
    <div class="flex justify-center mb-8">
      <button id="modalPlayBtn" onclick="toggleModalPlay()" class="bg-indigo-600 hover:bg-indigo-500 rounded-full p-8 transition-all transform hover:scale-110 shadow-2xl" style="box-shadow: 0 0 40px rgba(99,102,241,0.5);">
        <svg class="w-16 h-16 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </button>
    </div>
    
    <!-- Equalizer Visualizer Canvas -->
    <canvas id="particleCanvas" class="mb-6 rounded-lg w-full" height="200"></canvas>

    <!-- Progress Bar (Seekable) -->
    <div class="mb-2">
      <input 
        type="range" 
        id="progressBar" 
        min="0" 
        max="100" 
        value="0" 
        class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-indigo-500"
        style="background: linear-gradient(to right, #6366f1 0%, #334155 0%);"
      >
    </div>
    
    <!-- Time Display -->
    <div id="modalTime" class="text-center text-slate-300 text-xl mb-4">0:00 / 0:00</div>
    
    <!-- Download Button -->
    <div class="text-center">
      <a id="modalDownload" href="#" download class="inline-block bg-purple-600 hover:bg-purple-500 text-white font-medium tracking-widest py-3 px-8 rounded-xl shadow-lg transition-all">
        Download MP3
      </a>
    </div>
  </div>
</div>

<div class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 px-4 py-16">
  <div class="container mx-auto max-w-6xl">
    <div class="text-center mb-12">
      <h1 class="text-5xl font-bold tracking-wider text-white tracking-wide mb-2">My Memflections</h1>
      <p class="text-slate-300 text-lg">Your personalized audio reflections</p>
    </div>

    <% if params[:purchased] == 'true' %>
      <div class="bg-green-500/20 border border-green-500/50 text-white px-6 py-4 rounded-lg mb-8 text-center">
        <p class="font-bold text-lg">🎉 Payment Successful!</p>
        <p class="text-sm mt-1">Your extended Memflection is being generated. Refresh in a few minutes to download it!</p>
      </div>
    <% end %>

    <% if @reflections.where(purchased: true).any? %>
      <div class="bg-black/50 backdrop-blur-xl rounded-2xl shadow-2xl border border-white/20 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="bg-white/5 border-b border-white/10">
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-300 uppercase tracking-wider">Name</th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-300 uppercase tracking-wider hidden md:table-cell">Style</th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-300 uppercase tracking-wider hidden sm:table-cell">Date</th>
                <th class="px-6 py-4 text-center text-xs font-semibold text-slate-300 uppercase tracking-wider">Play</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/10">
              <% @reflections.where(purchased: true).each do |reflection| %>
                <tr class="hover:bg-white/5 transition-colors" id="reflection_row_<%= reflection.id %>">
                  <td class="px-6 py-4">
                    <p class="text-white font-medium"><%= reflection.title || "Untitled" %></p>
                    <% unless reflection.extended_audio.attached? %>
                      <p class="text-yellow-400 text-xs mt-1 animate-pulse">⏳ Processing...</p>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 text-slate-300 text-sm hidden md:table-cell"><%= reflection.style %></td>
                  <td class="px-6 py-4 text-slate-300 text-sm hidden sm:table-cell"><%= reflection.created_at.strftime("%b %d, %Y") %></td>
                  <td class="px-6 py-4 text-center">
                    <% if reflection.extended_audio.attached? %>
                      <div class="flex flex-col items-center gap-2">
                        <button
                          onclick="openAudioModal('<%= j(reflection.title || 'Untitled') %>', '<%= extended_audio_url(reflection, play: true) %>', '<%= extended_audio_url(reflection) %>')"
                          class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-3 px-6 rounded-lg transition-all transform hover:scale-105 shadow-lg" style="box-shadow: 0 0 20px rgba(99,102,241,0.3);">
                          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M8 5v14l11-7z"/>
                          </svg>
                          Play
                        </button>
                        <div class="flex items-center gap-3">
                          <%= link_to "Download", extended_audio_path(reflection), class: "text-purple-400 hover:text-purple-300 font-medium text-sm" %>
                          <span class="text-white/20">|</span>
                          <button onclick="shareReflection('<%= extended_audio_url(reflection) %>', '<%= j(reflection.title || 'Untitled') %>')" class="text-sky-400 hover:text-sky-300 font-medium text-sm transition-colors">
                            🔗 Share
                          </button>
                        </div>
                      </div>
                    <% elsif reflection.status == 'failed' %>
                      <span class="text-red-400 text-sm">⚠️ Generation failed</span>
                    <% else %>
                      <span class="text-slate-500 text-sm">Processing...</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="text-center mt-8">
        <%= link_to "Create New Memflection", new_reflection_path, class: "bg-sky-600 hover:bg-sky-500 text-white font-semibold py-3 px-8 rounded-lg shadow-lg inline-block" %>
      </div>
    <% else %>
      <div class="text-center py-16">
        <p class="text-slate-300 text-xl mb-8">You haven't purchased any Memflections yet.</p>
        <%= link_to "Create Your First Memflection", new_reflection_path, class: "bg-sky-600 hover:bg-sky-500 text-white font-bold py-4 px-8 rounded-lg shadow-lg inline-block text-lg" %>
      </div>
    <% end %>
  </div>
</div>

<script>
  let audioContext, analyser, dataArray, audioElement, animationId;
  const canvas = document.getElementById('particleCanvas');
  const ctx = canvas.getContext('2d');

  const BAR_COUNT = 48;
  let barHeights = new Array(BAR_COUNT).fill(0);
  let barTargets = new Array(BAR_COUNT).fill(0);

  function initParticles() {
    barHeights = new Array(BAR_COUNT).fill(0);
    barTargets = new Array(BAR_COUNT).fill(0);
  }

  function animate() {
    canvas.width = canvas.offsetWidth;
    const W = canvas.width;
    const H = canvas.height;
    ctx.clearRect(0, 0, W, H);

    // Background
    ctx.fillStyle = 'rgba(10, 10, 30, 0.95)';
    ctx.fillRect(0, 0, W, H);

    const barWidth = (W / BAR_COUNT) * 0.7;
    const gap = (W / BAR_COUNT) * 0.3;

    if (analyser) {
      analyser.getByteFrequencyData(dataArray);
    }

    for (let i = 0; i < BAR_COUNT; i++) {
      let value;
      if (analyser && audioElement && !audioElement.paused) {
        value = dataArray[Math.floor(i * dataArray.length / BAR_COUNT)] / 255;
      } else {
        // Idle breathing animation
        value = 0.05 + 0.04 * Math.sin(Date.now() / 800 + i * 0.4);
      }

      barTargets[i] = value;
      barHeights[i] += (barTargets[i] - barHeights[i]) * 0.15;

      const barH = Math.max(4, barHeights[i] * H * 0.85);
      const x = i * (barWidth + gap) + gap / 2;
      const y = H - barH;

      // Gradient per bar: indigo → violet → purple
      const grad = ctx.createLinearGradient(x, y, x, H);
      grad.addColorStop(0, `hsla(${240 + i * 1.5}, 80%, 75%, 0.9)`);
      grad.addColorStop(0.5, `hsla(${260 + i * 1.2}, 70%, 60%, 0.8)`);
      grad.addColorStop(1, `hsla(${280 + i}, 60%, 40%, 0.6)`);

      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.roundRect(x, y, barWidth, barH, [3, 3, 0, 0]);
      ctx.fill();

      // Glow on tall bars
      if (barHeights[i] > 0.5) {
        ctx.shadowColor = `hsla(${250 + i}, 80%, 70%, 0.6)`;
        ctx.shadowBlur = 8;
        ctx.fill();
        ctx.shadowBlur = 0;
      }
    }

    animationId = requestAnimationFrame(animate);
  }

  async function openAudioModal(title, audioUrl, downloadUrl) {
    document.getElementById('audioModal').classList.remove('hidden');
    document.getElementById('modalTitle').textContent = title;
    document.getElementById('modalDownload').href = downloadUrl;
    
    canvas.width = canvas.offsetWidth;
    initParticles();
    animate();
    
    const response = await fetch(audioUrl);
    const finalUrl = response.url;
    
    if (!audioElement) {
      audioElement = new Audio();
    }
    
    audioElement.src = finalUrl;
    
    audioElement.addEventListener('play', () => {
      document.getElementById('modalPlayBtn').innerHTML = '<svg class="w-16 h-16 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/></svg>';
    });
    
    audioElement.addEventListener('pause', () => {
      document.getElementById('modalPlayBtn').innerHTML = '<svg class="w-16 h-16 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>';
    });
    
    audioElement.addEventListener('timeupdate', () => {
      const current = audioElement.currentTime;
      const duration = audioElement.duration || 0;
      document.getElementById('modalTime').textContent = formatTime(current) + ' / ' + formatTime(duration);
      updateProgressBar();
    });
    
    audioElement.addEventListener('loadedmetadata', () => {
      document.getElementById('modalTime').textContent = '0:00 / ' + formatTime(audioElement.duration);
    });
  }

  function closeAudioModal() {
    document.getElementById('audioModal').classList.add('hidden');
    if (audioElement) audioElement.pause();
    cancelAnimationFrame(animationId);
  }

  function toggleModalPlay() {
    if (audioElement) {
      if (audioElement.paused) {
        audioElement.play();
      } else {
        audioElement.pause();
      }
    }
  }

  function formatTime(seconds) {
    const minutes = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return minutes + ':' + (secs < 10 ? '0' : '') + secs;
  }

  document.getElementById('progressBar').addEventListener('input', function(e) {
    if (audioElement && audioElement.duration) {
      const seekTime = (e.target.value / 100) * audioElement.duration;
      audioElement.currentTime = seekTime;
    }
  });

  function updateProgressBar() {
    if (audioElement && audioElement.duration) {
      const progress = (audioElement.currentTime / audioElement.duration) * 100;
      const progressBar = document.getElementById('progressBar');
      progressBar.value = progress;
      progressBar.style.background = `linear-gradient(to right, #6366f1 ${progress}%, #334155 ${progress}%)`;
    }
  }

  async function shareReflection(audioUrl, title) {
    try {
      const response = await fetch(audioUrl);
      const finalUrl = response.url;
      const blob = await response.blob();
      const file = new File([blob], `memflect.app - ${title}.mp3`, { type: 'audio/mpeg' });

      if (navigator.canShare && navigator.canShare({ files: [file] })) {
        await navigator.share({
          files: [file],
          title: title,
          text: `🎧 "${title}" — a therapeutic audio reflection I created at memflect.com`
        });
      } else {
        await navigator.clipboard.writeText(`🎧 "${title}" — a therapeutic audio reflection I created at memflect.com`);
        alert('Copied to clipboard! Paste into WhatsApp or email.');
      }
    } catch (err) {
      console.error('Share failed:', err);
    }
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeAudioModal();
  });
</script>

<!-- Account Deletion Section -->
<div class="container mx-auto max-w-6xl mt-16 pt-8 border-t border-white/10">
  <div class="text-center">
    <p class="text-slate-500 text-sm mb-3">Need to delete your account?</p>
    <%= button_to "Delete My Account & All Data", 
        delete_account_path, 
        method: :delete,
        data: { 
          turbo_confirm: "⚠️ Are you sure? This will permanently delete all your reflections and cannot be undone." 
        },
        class: "text-red-400 hover:text-red-300 text-sm underline cursor-pointer" %>
  </div>
</div>

</div>
