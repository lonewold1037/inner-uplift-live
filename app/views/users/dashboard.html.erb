<%= turbo_stream_from "user_#{current_user.id}_dashboard" %>

<!-- Audio Player Modal (Hidden by default) -->
<div id="audioModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 rounded-2xl shadow-2xl max-w-4xl w-full p-8 border border-white/20 relative">
    <!-- Close Button -->
    <button onclick="closeAudioModal()" class="absolute top-4 right-4 text-white/60 hover:text-white text-3xl">&times;</button>

    <!-- Cover Image (above title, hidden if no image) -->
    <div id="modalImageWrap" class="hidden flex justify-center mb-6">
      <img id="modalCoverImage" src="" alt=""
           class="rounded-2xl shadow-2xl object-cover max-h-64 w-auto border border-white/10"
           style="filter: sepia(30%) contrast(110%) brightness(95%) saturate(85%);">
    </div>

    <!-- Reflection Title -->
    <h2 id="modalTitle" class="text-3xl font-bold tracking-wider text-white text-center mb-8">Loading...</h2>

    <!-- Large Play/Pause Button -->
    <div class="flex justify-center mb-8">
      <button id="modalPlayBtn" onclick="toggleModalPlay()" class="bg-indigo-600 hover:bg-indigo-500 rounded-full p-8 transition-all transform hover:scale-110 shadow-2xl" style="box-shadow: 0 0 40px rgba(99,102,241,0.5);">
        <svg class="w-16 h-16 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </button>
    </div>

    <!-- Equalizer Visualizer Canvas -->
    <canvas id="particleCanvas" class="mb-6 rounded-lg w-full" height="200"></canvas>

    <!-- Progress Bar (Seekable) -->
    <div class="mb-2">
      <input
        type="range"
        id="progressBar"
        min="0"
        max="100"
        value="0"
        class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-indigo-500"
        style="background: linear-gradient(to right, #6366f1 0%, #334155 0%);"
      >
    </div>

    <!-- Time Display -->
    <div id="modalTime" class="text-center text-slate-300 text-xl mb-4">0:00 / 0:00</div>

    <!-- Download Button -->
    <div class="text-center">
      <a id="modalDownload" href="#" download class="inline-block bg-purple-600 hover:bg-purple-500 text-white font-medium tracking-widest py-3 px-8 rounded-xl shadow-lg transition-all">
        Download MP3
      </a>
    </div>
  </div>
</div>

<!-- ========== MEMCARD SHARE MODAL ========== -->
<div id="memcardModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 rounded-2xl shadow-2xl max-w-xl w-full p-8 border border-purple-500/30 relative">

    <!-- Close Button -->
    <button onclick="closeMemcardModal()" class="absolute top-4 right-4 text-white/60 hover:text-white text-3xl">&times;</button>

    <!-- Header -->
    <div class="text-center mb-6">
      <p class="text-4xl mb-2">✨</p>
      <h2 class="text-2xl font-bold tracking-wider text-white mb-2">Share <span id="memcardModalTitle"></span></h2>
      <p class="text-slate-300 text-sm" style="text-transform: none; letter-spacing: normal;">
        Anyone with this link can view your Memflection in the cinematic portal.<br>
        <strong class="text-pink-300">Only share with people you trust.</strong>
      </p>
    </div>

    <!-- URL Copy Field -->
    <div class="mb-4">
      <label class="block text-slate-400 text-xs uppercase tracking-wider mb-2">Your Memcard Link</label>
      <div class="flex gap-2">
        <input type="text" id="memcardUrlField" readonly
               class="flex-1 bg-slate-800/70 text-white border-2 border-purple-500/30 rounded-lg px-4 py-3 text-sm font-mono focus:outline-none focus:border-purple-400"
               style="text-transform: none; letter-spacing: normal;">
        <button onclick="copyMemcardUrl()" id="memcardCopyBtn"
                class="bg-purple-600 hover:bg-purple-500 text-white font-medium tracking-wider px-4 py-3 rounded-lg transition-all">
          📋 Copy
        </button>
      </div>
    </div>

    <!-- View Count -->
    <div class="mb-6 text-center">
      <p class="text-slate-300 text-sm">
        📊 Viewed <span id="memcardViewCount" class="text-purple-300 font-bold"></span> times
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="space-y-3">
      <button onclick="shareMemcardNative()" class="w-full bg-gradient-to-r from-sky-600 to-blue-600 hover:from-sky-500 hover:to-blue-500 text-white font-medium tracking-wider py-3 px-6 rounded-lg shadow-lg transition-all">
        📱 Share via...
      </button>
      <button onclick="previewMemcard()" class="w-full bg-slate-700 hover:bg-slate-600 text-white font-medium tracking-wider py-3 px-6 rounded-lg transition-all">
        🔗 Preview Memcard
      </button>

      <!-- Disable Form -->
      <form id="memcardDisableForm" method="post" class="w-full">
        <input type="hidden" name="_method" value="delete">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <button type="submit"
                onclick="return confirm('Disable this Memcard link? Anyone with the current link will lose access permanently. You can re-share later, but the URL will be different.');"
                class="w-full bg-red-900/50 hover:bg-red-900/70 text-red-300 hover:text-red-200 border border-red-500/30 font-medium tracking-wider py-3 px-6 rounded-lg transition-all">
          🚫 Disable Sharing
        </button>
      </form>
    </div>

  </div>
</div>

<div class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 px-4 py-16">
  <div class="container mx-auto max-w-6xl">
    <div class="text-center mb-12">
      <h1 class="text-5xl font-bold tracking-wider text-white tracking-wide mb-2">My Memflections</h1>
      <p class="text-slate-300 text-lg">Your personalized audio reflections</p>
    </div>

    <%# ========== FLASH MESSAGES ========== %>
    <% if flash[:notice] %>
      <div class="bg-green-500/20 border border-green-500/50 text-white px-6 py-4 rounded-lg mb-8 text-center">
        <p class="text-sm"><%= flash[:notice] %></p>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="bg-red-500/20 border border-red-500/50 text-white px-6 py-4 rounded-lg mb-8 text-center">
        <p class="text-sm"><%= flash[:alert] %></p>
      </div>
    <% end %>

    <% if params[:purchased] == 'true' %>
      <div class="bg-green-500/20 border border-green-500/50 text-white px-6 py-4 rounded-lg mb-8 text-center">
        <p class="font-bold text-lg">🎉 Payment Successful!</p>
        <p class="text-sm mt-1">Your extended Memflection is being generated. Refresh in a few minutes to download it!</p>
      </div>
    <% end %>

    <% if @reflections.where(purchased: true).any? %>
      <div class="bg-black/50 backdrop-blur-xl rounded-2xl shadow-2xl border border-white/20 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="bg-white/5 border-b border-white/10">
                <th class="px-3 py-4 hidden sm:table-cell w-20"></th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-300 uppercase tracking-wider">Name</th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-300 uppercase tracking-wider hidden md:table-cell">Style</th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-300 uppercase tracking-wider hidden sm:table-cell">Date</th>
                <th class="px-6 py-4 text-center text-xs font-semibold text-slate-300 uppercase tracking-wider">Play</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/10">
              <% @reflections.where(purchased: true).each do |reflection| %>
                <tr class="hover:bg-white/5 transition-colors" id="reflection_row_<%= reflection.id %>">

                  <!-- Cover Image -->
                  <td class="px-3 py-3 w-20 hidden sm:table-cell">
                    <% if reflection.cover_image.attached? %>
                      <img src="<%= url_for(reflection.cover_image) %>"
                           alt="<%= reflection.title %>"
                           class="w-16 h-16 rounded-xl object-cover shadow-lg"
                           style="filter: sepia(30%) contrast(110%) brightness(95%) saturate(85%);">
                    <% else %>
                      <div class="w-16 h-16 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                        <svg class="w-6 h-6 text-white/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                      </div>
                    <% end %>
                  </td>

                  <td class="px-6 py-4">
                    <p class="text-white font-medium"><%= reflection.title || "Untitled" %></p>
                    <% unless reflection.extended_audio.attached? %>
                      <p class="text-yellow-400 text-xs mt-1 animate-pulse">⏳ Processing...</p>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 text-slate-300 text-sm hidden md:table-cell"><%= reflection.style %></td>
                  <td class="px-6 py-4 text-slate-300 text-sm hidden sm:table-cell"><%= reflection.created_at.strftime("%b %d, %Y") %></td>
                  <td class="px-6 py-4 text-center">
                    <% if reflection.extended_audio.attached? %>
                      <div class="flex flex-col items-center gap-2">
                        <button
                          onclick="openAudioModal('<%= j(reflection.title || 'Untitled') %>', '<%= extended_audio_url(reflection, play: true) %>', '<%= extended_audio_url(reflection) %>', '<%= reflection.cover_image.attached? ? url_for(reflection.cover_image) : '' %>')"
                          class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-3 px-6 rounded-lg transition-all transform hover:scale-105 shadow-lg" style="box-shadow: 0 0 20px rgba(99,102,241,0.3);">
                          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M8 5v14l11-7z"/>
                          </svg>
                          Play
                        </button>
                        <div class="flex items-center gap-3">
                          <%= link_to "Download", extended_audio_path(reflection), class: "text-purple-400 hover:text-purple-300 font-medium text-sm" %>
                          <span class="text-white/20">|</span>
                          <button onclick="shareReflection('<%= extended_audio_url(reflection) %>', '<%= j(reflection.title || 'Untitled') %>')" class="text-sky-400 hover:text-sky-300 font-medium text-sm transition-colors">
                            📎 Share File
                          </button>
                        </div>

                        <%# ========== SHARE AS MEMCARD BUTTON ========== %>
                        <div class="mt-1">
                          <% if reflection.memcard_enabled? %>
                            <button onclick="openMemcardModal('<%= reflection.id %>', '<%= j(reflection.memcard_token) %>', '<%= j(reflection.title || 'Untitled') %>', <%= reflection.memcard_view_count %>)"
                                    class="inline-flex items-center gap-2 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-medium tracking-wider text-xs py-2 px-4 rounded-lg shadow-lg transition-all transform hover:scale-105"
                                    style="box-shadow: 0 0 15px rgba(168,85,247,0.4);">
                              ✨ Memcard Active — Manage
                            </button>
                          <% else %>
                            <%= button_to enable_memcard_reflection_path(reflection), method: :post, form: { class: "inline" }, class: "inline-flex items-center gap-2 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-medium tracking-wider text-xs py-2 px-4 rounded-lg shadow-lg transition-all transform hover:scale-105 cursor-pointer", style: "box-shadow: 0 0 15px rgba(168,85,247,0.4);" do %>
                              ✨ Share as Memcard
                            <% end %>
                          <% end %>
                        </div>

                      </div>
                    <% elsif reflection.status == 'failed' %>
                      <span class="text-red-400 text-sm">⚠️ Generation failed</span>
                    <% else %>
                      <span class="text-slate-500 text-sm">Processing...</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="text-center mt-8">
        <%= link_to "Create New Memflection", new_reflection_path, class: "bg-sky-600 hover:bg-sky-500 text-white font-semibold py-3 px-8 rounded-lg shadow-lg inline-block" %>
      </div>
    <% else %>
      <div class="text-center py-16">
        <p class="text-slate-300 text-xl mb-8">You haven't purchased any Memflections yet.</p>
        <%= link_to "Create Your First Memflection", new_reflection_path, class: "bg-sky-600 hover:bg-sky-500 text-white font-bold py-4 px-8 rounded-lg shadow-lg inline-block text-lg" %>
      </div>
    <% end %>
  </div>
</div>

<script>
  let audioContext, analyser, dataArray, audioElement, animationId;
  const canvas = document.getElementById('particleCanvas');
  const ctx = canvas.getContext('2d');

  const BAR_COUNT = 48;
  let barHeights = new Array(BAR_COUNT).fill(0);
  let barTargets = new Array(BAR_COUNT).fill(0);

  function initParticles() {
    barHeights = new Array(BAR_COUNT).fill(0);
    barTargets = new Array(BAR_COUNT).fill(0);
  }

  function animate() {
    canvas.width = canvas.offsetWidth;
    const W = canvas.width;
    const H = canvas.height;
    ctx.clearRect(0, 0, W, H);

    ctx.fillStyle = 'rgba(10, 10, 30, 0.95)';
    ctx.fillRect(0, 0, W, H);

    const barWidth = (W / BAR_COUNT) * 0.7;
    const gap = (W / BAR_COUNT) * 0.3;

    if (analyser) {
      analyser.getByteFrequencyData(dataArray);
    }

    for (let i = 0; i < BAR_COUNT; i++) {
      let value;
      if (analyser && audioElement && !audioElement.paused) {
        value = dataArray[Math.floor(i * dataArray.length / BAR_COUNT)] / 255;
      } else {
        value = 0.05 + 0.04 * Math.sin(Date.now() / 800 + i * 0.4);
      }

      barTargets[i] = value;
      barHeights[i] += (barTargets[i] - barHeights[i]) * 0.15;

      const barH = Math.max(4, barHeights[i] * H * 0.85);
      const x = i * (barWidth + gap) + gap / 2;
      const y = H - barH;

      const grad = ctx.createLinearGradient(x, y, x, H);
      grad.addColorStop(0, `hsla(${240 + i * 1.5}, 80%, 75%, 0.9)`);
      grad.addColorStop(0.5, `hsla(${260 + i * 1.2}, 70%, 60%, 0.8)`);
      grad.addColorStop(1, `hsla(${280 + i}, 60%, 40%, 0.6)`);

      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.roundRect(x, y, barWidth, barH, [3, 3, 0, 0]);
      ctx.fill();

      if (barHeights[i] > 0.5) {
        ctx.shadowColor = `hsla(${250 + i}, 80%, 70%, 0.6)`;
        ctx.shadowBlur = 8;
        ctx.fill();
        ctx.shadowBlur = 0;
      }
    }

    animationId = requestAnimationFrame(animate);
  }

  async function openAudioModal(title, audioUrl, downloadUrl, imageUrl) {
    document.getElementById('audioModal').classList.remove('hidden');
    document.getElementById('modalTitle').textContent = title;
    document.getElementById('modalDownload').href = downloadUrl;

    // Handle cover image
    const imageWrap = document.getElementById('modalImageWrap');
    const coverImage = document.getElementById('modalCoverImage');
    if (imageUrl && imageUrl.trim() !== '') {
      coverImage.src = imageUrl;
      imageWrap.classList.remove('hidden');
      imageWrap.classList.add('flex');
    } else {
      imageWrap.classList.add('hidden');
      imageWrap.classList.remove('flex');
      coverImage.src = '';
    }

    canvas.width = canvas.offsetWidth;
    initParticles();
    animate();

    const response = await fetch(audioUrl);
    const finalUrl = response.url;

    if (!audioElement) {
      audioElement = new Audio();
    }

    audioElement.src = finalUrl;

    audioElement.addEventListener('play', () => {
      document.getElementById('modalPlayBtn').innerHTML = '<svg class="w-16 h-16 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/></svg>';
    });

    audioElement.addEventListener('pause', () => {
      document.getElementById('modalPlayBtn').innerHTML = '<svg class="w-16 h-16 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>';
    });

    audioElement.addEventListener('timeupdate', () => {
      const current = audioElement.currentTime;
      const duration = audioElement.duration || 0;
      document.getElementById('modalTime').textContent = formatTime(current) + ' / ' + formatTime(duration);
      updateProgressBar();
    });

    audioElement.addEventListener('loadedmetadata', () => {
      document.getElementById('modalTime').textContent = '0:00 / ' + formatTime(audioElement.duration);
    });
  }

  function closeAudioModal() {
    document.getElementById('audioModal').classList.add('hidden');
    if (audioElement) audioElement.pause();
    cancelAnimationFrame(animationId);
  }

  function toggleModalPlay() {
    if (audioElement) {
      if (audioElement.paused) {
        audioElement.play();
      } else {
        audioElement.pause();
      }
    }
  }

  function formatTime(seconds) {
    const minutes = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return minutes + ':' + (secs < 10 ? '0' : '') + secs;
  }

  document.getElementById('progressBar').addEventListener('input', function(e) {
    if (audioElement && audioElement.duration) {
      const seekTime = (e.target.value / 100) * audioElement.duration;
      audioElement.currentTime = seekTime;
    }
  });

  function updateProgressBar() {
    if (audioElement && audioElement.duration) {
      const progress = (audioElement.currentTime / audioElement.duration) * 100;
      const progressBar = document.getElementById('progressBar');
      progressBar.value = progress;
      progressBar.style.background = `linear-gradient(to right, #6366f1 ${progress}%, #334155 ${progress}%)`;
    }
  }

  async function shareReflection(audioUrl, title) {
    try {
      const response = await fetch(audioUrl);
      const finalUrl = response.url;
      const blob = await response.blob();
      const file = new File([blob], `memflect.app - ${title}.mp3`, { type: 'audio/mpeg' });

      if (navigator.canShare && navigator.canShare({ files: [file] })) {
        await navigator.share({
          files: [file],
          title: title,
          text: `🎧 "${title}" — a therapeutic audio reflection I created at memflect.com`
        });
      } else {
        await navigator.clipboard.writeText(`🎧 "${title}" — a therapeutic audio reflection I created at memflect.com`);
        alert('Copied to clipboard! Paste into WhatsApp or email.');
      }
    } catch (err) {
      console.error('Share failed:', err);
    }
  }

  // ========== MEMCARD MODAL ==========
  let currentMemcardToken = null;

  function openMemcardModal(reflectionId, token, title, viewCount) {
    currentMemcardToken = token;
    const url = `${window.location.origin}/m/${token}`;

    document.getElementById('memcardModalTitle').textContent = title;
    document.getElementById('memcardUrlField').value = url;
    document.getElementById('memcardViewCount').textContent = viewCount;
    document.getElementById('memcardDisableForm').action = `/reflections/${reflectionId}/disable_memcard`;

    document.getElementById('memcardModal').classList.remove('hidden');
  }

  function closeMemcardModal() {
    document.getElementById('memcardModal').classList.add('hidden');
    currentMemcardToken = null;
  }

  async function copyMemcardUrl() {
    const field = document.getElementById('memcardUrlField');
    const btn = document.getElementById('memcardCopyBtn');
    try {
      await navigator.clipboard.writeText(field.value);
      const originalText = btn.innerHTML;
      btn.innerHTML = '✓ Copied!';
      btn.classList.add('bg-green-600');
      btn.classList.remove('bg-purple-600', 'hover:bg-purple-500');
      setTimeout(() => {
        btn.innerHTML = originalText;
        btn.classList.remove('bg-green-600');
        btn.classList.add('bg-purple-600', 'hover:bg-purple-500');
      }, 2000);
    } catch (err) {
      field.select();
      document.execCommand('copy');
      btn.innerHTML = '✓ Copied!';
      setTimeout(() => { btn.innerHTML = '📋 Copy'; }, 2000);
    }
  }

  async function shareMemcardNative() {
    const url = document.getElementById('memcardUrlField').value;
    const title = document.getElementById('memcardModalTitle').textContent;
    const shareText = `🎭 "${title}" — a personal Memflection I want to share with you. Tap to open the cinematic portal.`;

    if (navigator.share) {
      try {
        await navigator.share({
          title: `Memcard: ${title}`,
          text: shareText,
          url: url
        });
      } catch (err) {
        if (err.name !== 'AbortError') console.error('Share failed:', err);
      }
    } else {
      try {
        await navigator.clipboard.writeText(`${shareText}\n\n${url}`);
        alert('Share text copied to clipboard! Paste into any app to share.');
      } catch (err) {
        alert(`Share this link:\n\n${url}`);
      }
    }
  }

  function previewMemcard() {
    if (currentMemcardToken) {
      window.open(`/m/${currentMemcardToken}`, '_blank');
    }
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeAudioModal();
      closeMemcardModal();
    }
  });
</script>

<!-- Account Deletion Section -->
<div class="container mx-auto max-w-6xl mt-16 pt-8 border-t border-white/10">
  <div class="text-center">
    <p class="text-slate-500 text-sm mb-3">Need to delete your account?</p>
    <%= button_to "Delete My Account & All Data",
        delete_account_path,
        method: :delete,
        data: {
          turbo_confirm: "⚠️ Are you sure? This will permanently delete all your reflections and cannot be undone."
        },
        class: "text-red-400 hover:text-red-300 text-sm underline cursor-pointer" %>
  </div>
</div>

</div>