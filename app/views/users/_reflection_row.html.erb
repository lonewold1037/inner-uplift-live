<tr class="hover:bg-white/5 transition-colors" id="reflection_row_<%= reflection.id %>">

  <!-- Cover Image Column -->
  <td class="px-3 py-3 w-20 hidden sm:table-cell">
    <% if reflection.cover_image.attached? %>
      <img src="<%= url_for(reflection.cover_image) %>"
           alt="<%= reflection.title %>"
           class="w-16 h-16 rounded-xl object-cover shadow-lg"
           style="filter: sepia(30%) contrast(110%) brightness(95%) saturate(85%);">
    <% else %>
      <div class="w-16 h-16 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
        <svg class="w-6 h-6 text-white/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
      </div>
    <% end %>
  </td>

  <td class="px-6 py-4">
    <p class="text-white font-medium"><%= reflection.title || "Untitled" %></p>
    <% unless reflection.extended_audio.attached? %>
      <p class="text-yellow-400 text-xs mt-1 animate-pulse">⏳ Processing...</p>
    <% end %>
  </td>
  <td class="px-6 py-4 text-slate-300 text-sm hidden md:table-cell"><%= reflection.style %></td>
  <td class="px-6 py-4 text-slate-300 text-sm hidden lg:table-cell"><%= reflection.soundscape&.category || "—" %></td>
  <td class="px-6 py-4 text-slate-300 text-sm hidden sm:table-cell"><%= reflection.created_at.strftime("%b %d, %Y") %></td>
  <td class="px-6 py-4 text-center">
    <% if reflection.extended_audio.attached? %>
      <div class="flex flex-col items-center gap-2">
        <button
          onclick="openAudioModal('<%= j(reflection.title || 'Untitled') %>', '<%= extended_audio_url(reflection, play: true) %>', '<%= extended_audio_url(reflection) %>', '<%= reflection.cover_image.attached? ? url_for(reflection.cover_image) : '' %>')"
          class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-3 px-6 rounded-lg transition-all transform hover:scale-105 shadow-lg" style="box-shadow: 0 0 20px rgba(99,102,241,0.3);">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
          Play
        </button>
        <div class="flex items-center gap-3">
          <%= link_to "Download", extended_audio_path(reflection), class: "text-purple-400 hover:text-purple-300 font-medium text-sm", data: { turbo: false } %>
          <span class="text-white/20">|</span>
          <button onclick="shareReflection('<%= extended_audio_url(reflection) %>', '<%= j(reflection.title || 'Untitled') %>')" class="text-sky-400 hover:text-sky-300 font-medium text-sm transition-colors">
            🔗 Share
          </button>
        </div>
      </div>
    <% else %>
      <span class="text-slate-500 text-sm">Processing...</span>
    <% end %>
  </td>
</tr>
