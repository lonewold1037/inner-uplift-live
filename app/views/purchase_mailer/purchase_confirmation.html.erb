<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin: 0; padding: 0; background-color: #fdf6ff; font-family: Georgia, serif;">

  <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #fdf6ff; padding: 40px 20px;">
    <tr>
      <td align="center">
        <table width="100%" cellpadding="0" cellspacing="0" style="max-width: 520px;">

          <%# Logo %>
          <tr>
            <td align="center" style="padding-bottom: 24px;">
              <span style="font-family: Arial, sans-serif; font-size: 28px; font-weight: bold; letter-spacing: 6px; color: #6d28d9;">MEMFLECT</span>
            </td>
          </tr>

          <%# Card %>
          <tr>
            <td style="background-color: #ffffff; border-radius: 16px; padding: 40px 36px; border: 1px solid rgba(109,40,217,0.12); box-shadow: 0 4px 24px rgba(109,40,217,0.08);">

              <p style="font-size: 26px; margin: 0 0 4px; text-align: center;">🎉</p>
              <p style="font-size: 22px; font-weight: bold; color: #3b0764; margin: 0 0 8px; font-family: Arial, sans-serif; letter-spacing: 1px; text-align: center;">
                Payment Successful!
              </p>

              <p style="font-size: 15px; color: #6d28d9; margin: 0 0 20px; line-height: 1.7; text-align: center;">
                Your Memflection is being created right now. This usually takes 2–3 minutes. We'll have it waiting in your dashboard.
              </p>

              <%# Reflection title if available %>
              <% if @reflection.title.present? %>
                <div style="background: #faf8ff; border-left: 4px solid #7c3aed; border-radius: 0 12px 12px 0; padding: 14px 18px; margin-bottom: 24px;">
                  <p style="font-family: Arial, sans-serif; font-size: 11px; letter-spacing: 2px; color: #a78bfa; margin: 0 0 4px;">YOUR MEMFLECTION</p>
                  <p style="font-family: Georgia, serif; font-size: 17px; color: #3b0764; margin: 0; font-style: italic;">"<%= @reflection.title %>"</p>
                </div>
              <% end %>

              <%# What happens next %>
              <div style="background: #f0fdf4; border-radius: 12px; padding: 18px 20px; margin-bottom: 28px; border: 1px solid rgba(34,197,94,0.2);">
                <p style="font-family: Arial, sans-serif; font-size: 11px; letter-spacing: 2px; color: #16a34a; margin: 0 0 12px;">WHAT HAPPENS NEXT</p>
                <table cellpadding="0" cellspacing="0" width="100%">
                  <% [
                    ["🎤", "Your voice is being cloned by ElevenLabs"],
                    ["🎵", "Your reflection is being mixed with your chosen soundscape"],
                    ["📥", "Your full 5-minute Memflection will appear in your dashboard"]
                  ].each do |emoji, text| %>
                    <tr>
                      <td style="width: 28px; vertical-align: top; padding-bottom: 8px;">
                        <span style="font-size: 14px;"><%= emoji %></span>
                      </td>
                      <td style="vertical-align: top; padding-bottom: 8px; padding-left: 8px;">
                        <span style="font-family: Georgia, serif; font-size: 14px; color: #166534; line-height: 1.5;"><%= text %></span>
                      </td>
                    </tr>
                  <% end %>
                </table>
              </div>

              <%# CTA button %>
              <table cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 24px;">
                <tr>
                  <td align="center">
                    <a href="<%= @dashboard_url %>"
                       style="display: inline-block; background: linear-gradient(135deg, #7c3aed 0%, #be185d 100%); color: #ffffff; font-family: Arial, sans-serif; font-size: 14px; font-weight: bold; letter-spacing: 2px; text-decoration: none; padding: 16px 40px; border-radius: 100px;">
                      GO TO MY DASHBOARD
                    </a>
                  </td>
                </tr>
              </table>

              <p style="font-size: 12px; color: #c4b5fd; line-height: 1.6; margin: 0; border-top: 1px solid rgba(109,40,217,0.08); padding-top: 16px; text-align: center;">
                Questions? Reply to this email or reach us at <a href="mailto:ryan@memflect.com" style="color: #a78bfa;">ryan@memflect.com</a>
              </p>

            </td>
          </tr>

          <%# Footer %>
          <tr>
            <td align="center" style="padding-top: 24px;">
              <p style="font-size: 11px; color: #c4b5fd; margin: 0 0 6px; font-family: Arial, sans-serif; letter-spacing: 1px;">
                © <%= Date.current.year %> MEMFLECT · <a href="https://memflect.com" style="color: #a78bfa; text-decoration: none;">memflect.com</a>
              </p>
              <p style="font-size: 11px; color: #c4b5fd; margin: 0; font-family: Arial, sans-serif; line-height: 1.6;">
                1090 Lower Delta Road, #04-16, Singapore 169201
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
