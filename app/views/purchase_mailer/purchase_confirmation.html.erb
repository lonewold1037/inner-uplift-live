<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin: 0; padding: 0; background-color: #1a1a2e; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #1a1a2e; padding: 40px 20px;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="max-width: 600px; background: linear-gradient(180deg, #2d2d44 0%, #1a1a2e 100%); border-radius: 24px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1);">
          
          <!-- Header -->
          <tr>
            <td style="padding: 50px 40px 30px 40px; text-align: center;">
              <h1 style="margin: 0; font-size: 48px; font-weight: 700; background: linear-gradient(135deg, #a78bfa 0%, #f472b6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Memflect</h1>
            </td>
          </tr>
          
          <!-- Main Content -->
          <tr>
            <td style="padding: 20px 40px 40px 40px; text-align: center;">
              <p style="color: #e2e8f0; font-size: 28px; font-weight: 600; margin: 0 0 20px 0;">Hey there! 🎉</p>
              
              <p style="color: #cbd5e1; font-size: 18px; line-height: 1.7; margin: 0 0 15px 0;">Your Memflection is in the works – give it about 2-3 minutes.</p>
              
              <p style="color: #94a3b8; font-size: 16px; line-height: 1.7; margin: 0 0 35px 0;">We're taking your voice, your memory, and your chosen soundscape and weaving them into something that's completely yours.</p>
              
              <!-- Button -->
              <table cellpadding="0" cellspacing="0" style="margin: 0 auto;">
                <tr>
                  <td style="background: linear-gradient(135deg, #8b5cf6 0%, #ec4899 100%); border-radius: 50px; box-shadow: 0 8px 30px rgba(139, 92, 246, 0.4);">
                    <a href="<%= @dashboard_url %>" style="display: inline-block; padding: 18px 45px; color: #ffffff; font-size: 18px; font-weight: 600; text-decoration: none;">View Your Memflection ✨</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          
          <!-- What's Happening Section -->
          <tr>
            <td style="padding: 0 40px 40px 40px;">
              <table width="100%" cellpadding="0" cellspacing="0" style="background: rgba(255,255,255,0.05); border-radius: 16px; border: 1px solid rgba(255,255,255,0.1);">
                <tr>
                  <td style="padding: 25px 30px;">
                    <p style="color: #e2e8f0; font-size: 16px; font-weight: 600; margin: 0 0 15px 0; text-align: center;">What's happening right now:</p>
                    <p style="color: #94a3b8; font-size: 15px; line-height: 2; margin: 0;">
                      → Your personalized script is being crafted<br>
                      → Your own voice is narrating the reflection<br>
                      → Everything's getting mixed with your soundscape<br>
                      → Soon you'll be able to download and replay anytime
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          
          <!-- Personal Sign-off -->
          <tr>
            <td style="padding: 0 40px 40px 40px; text-align: center;">
              <p style="color: #94a3b8; font-size: 15px; line-height: 1.7; margin: 0;">Hit reply if you have any questions – I actually read these!</p>
              <p style="color: #cbd5e1; font-size: 16px; margin: 20px 0 0 0;">Cheers,<br><strong style="color: #a78bfa;">Ryan</strong> @ Memflect</p>
            </td>
          </tr>
          
          <!-- Footer -->
          <tr>
            <td style="padding: 25px 40px; border-top: 1px solid rgba(255,255,255,0.1); text-align: center;">
              <p style="color: #64748b; font-size: 13px; margin: 0;">© <%= Date.current.year %> Memflect</p>
            </td>
          </tr>
          
        </table>
      </td>
    </tr>
  </table>
</body>
</html>