<% content_for :title, @reflection.title %>

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 p-8">
  <div class="max-w-xl w-full bg-black/50 backdrop-blur-xl rounded-2xl border border-white/20 p-8 text-center">
    <p class="text-sky-400 text-sm uppercase tracking-widest mb-2">Memcard Portal (stub)</p>
    <h1 class="text-4xl font-bold text-white mb-6"><%= @reflection.title || "Untitled" %></h1>

    <% if @reflection.cover_image.attached? %>
      <img src="<%= url_for(@reflection.cover_image) %>" class="mx-auto rounded-xl mb-6 max-h-64 shadow-2xl" style="filter: sepia(30%) contrast(110%) brightness(95%) saturate(85%);">
    <% end %>

    <p class="text-slate-300 mb-4">Style: <%= @reflection.style %></p>
    <p class="text-slate-400 text-sm mb-6">View count: <%= @reflection.memcard_view_count %></p>

    <% if @reflection.extended_audio.attached? %>
      <audio controls class="w-full">
        <source src="<%= url_for(@reflection.extended_audio) %>" type="audio/mpeg">
      </audio>
    <% end %>

    <p class="text-slate-500 text-xs mt-8">This is a stub. The full cinematic theater experience is coming next.</p>
  </div>
</div>
