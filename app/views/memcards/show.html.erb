<%# ========== OG META TAGS — for beautiful link previews ========== %>
<% content_for :head do %>
  <title><%= @reflection.title || "A Memflection" %> — Memcard from Memflect</title>

  <%# Open Graph %>
  <meta property="og:title" content="<%= @reflection.title || "A Memflection" %>">
  <meta property="og:description" content="<%= @reflection.name_for_recap.present? ? "A Memflection from #{@reflection.name_for_recap}#{@reflection.recipient_name.present? ? " for #{@reflection.recipient_name}" : ""}. Tap to open the cinematic portal." : "A personal Memflection — a 5-minute cinematic audio reflection. Tap to open the portal." %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta property="og:site_name" content="Memflect">
  <% if @reflection.cover_image.attached? %>
    <meta property="og:image" content="<%= @reflection.cover_image.blob.url %>">
  <% else %>
    <meta property="og:image" content="https://memflect.com/images/memflect-og-default.jpg">
  <% end %>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <%# Twitter/X %>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= @reflection.title || "A Memflection" %>">
  <meta name="twitter:description" content="Tap to open the cinematic portal on Memflect.">
  <% if @reflection.cover_image.attached? %>
    <meta name="twitter:image" content="<%= @reflection.cover_image.blob.url %>">
  <% else %>
    <meta name="twitter:image" content="https://memflect.com/images/memflect-og-default.jpg">
  <% end %>
<% end %>

<style>
  /* ===== 3D STAGE FLOOR ===== */
  #stage-floor {
    position: absolute;
    bottom: 0; left: -10%; right: -10%;
    height: 35%;
    background: linear-gradient(to bottom,
      rgba(10, 6, 18, 0.0) 0%,
      rgba(10, 6, 18, 0.6) 20%,
      rgba(15, 10, 25, 0.85) 45%,
      rgba(20, 14, 32, 0.95) 100%
    );
    transform: perspective(600px) rotateX(25deg);
    transform-origin: bottom center;
    z-index: 1;
  }
  #stage-floor::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      90deg,
      transparent 0px,
      transparent 80px,
      rgba(168, 85, 247, 0.03) 80px,
      rgba(168, 85, 247, 0.03) 82px
    );
  }

  /* ===== SPOTLIGHT CONES ===== */
  .spotlight-cone {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }
  #spot-cone-left {
    left: 0;
    background: conic-gradient(
      from 155deg at 0% 0%,
      transparent 0deg,
      rgba(168, 85, 247, 0.06) 10deg,
      rgba(168, 85, 247, 0.10) 20deg,
      rgba(168, 85, 247, 0.06) 35deg,
      transparent 45deg
    );
  }
  #spot-cone-right {
    right: 0;
    background: conic-gradient(
      from -20deg at 100% 0%,
      transparent 0deg,
      rgba(251, 191, 36, 0.04) 10deg,
      rgba(251, 191, 36, 0.07) 20deg,
      rgba(251, 191, 36, 0.04) 35deg,
      transparent 45deg
    );
  }

  /* ===== SPOTLIGHT SOURCE GLOW (the "bulb" at the top) ===== */
  .spot-source {
    position: absolute;
    top: -2px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    z-index: 6;
    filter: blur(12px);
  }
  #spot-source-left {
    left: 3%;
    background: radial-gradient(circle, rgba(168,85,247,0.5) 0%, transparent 70%);
  }
  #spot-source-right {
    right: 3%;
    background: radial-gradient(circle, rgba(251,191,36,0.35) 0%, transparent 70%);
  }

  /* ===== IMAGE GLOW (spotlight hitting the photo) ===== */
  #image-spotlight-glow {
    position: absolute;
    top: -20px; left: -20px; right: -20px; bottom: -20px;
    border-radius: 20px;
    background: radial-gradient(ellipse at center, rgba(168,85,247,0.15) 0%, transparent 60%);
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 3s ease-in;
  }

  /* ===== CTA ROW RESPONSIVE ===== */
  .cta-link {
    white-space: nowrap;
    font-family: 'Bebas Neue', sans-serif;
    letter-spacing: 0.08em;
    font-size: 11px;
  }
  @media (min-width: 640px) {
    .cta-link { font-size: 13px; }
  }

  /* ===== FLOATING EMBER PARTICLES ===== */
  .ember {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    z-index: 5;
    animation: ember-float linear infinite;
  }
  @keyframes ember-float {
    0%   { opacity: 0; transform: translateY(0) translateX(0) scale(1); }
    10%  { opacity: 0.8; }
    50%  { opacity: 0.4; transform: translateY(-30vh) translateX(15px) scale(0.8); }
    90%  { opacity: 0.6; }
    100% { opacity: 0; transform: translateY(-60vh) translateX(-10px) scale(0.3); }
  }

  /* ===== FILM DUST SPECS ===== */
  .dust-spec {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 5;
    opacity: 0;
    animation: dust-blink ease-in-out infinite;
  }
  @keyframes dust-blink {
    0%, 100% { opacity: 0; }
    15% { opacity: 0.7; }
    30% { opacity: 0; }
    45% { opacity: 0.5; }
    55% { opacity: 0; }
    80% { opacity: 0.3; }
  }
</style>

<div id="memcard-stage" class="fixed inset-0 bg-black overflow-hidden flex flex-col">

  <%# ==================== THEATER SCREEN (top portion) ==================== %>
  <div id="theater-screen" class="relative flex-1 overflow-hidden flex flex-col">

    <%# ---- 3D STAGE FLOOR ---- %>
    <div id="stage-floor"></div>

    <%# ---- SPOTLIGHT CONES ---- %>
    <div id="spot-cone-left" class="spotlight-cone"></div>
    <div id="spot-cone-right" class="spotlight-cone"></div>
    <div id="spot-source-left" class="spot-source"></div>
    <div id="spot-source-right" class="spot-source"></div>

    <%# ---- VIGNETTE ---- %>
    <div class="absolute inset-0 pointer-events-none" style="
      z-index: 3;
      background: radial-gradient(ellipse at center, transparent 30%, rgba(0,0,0,0.4) 70%, rgba(0,0,0,0.75) 100%);
    "></div>

    <%# ---- FILM GRAIN + FLICKER ---- %>
    <div id="film-overlay" class="absolute inset-0 pointer-events-none" style="z-index: 4;">
      <div id="film-flicker" class="absolute inset-0 mix-blend-overlay" style="opacity: 0;
        background: radial-gradient(ellipse at 25% 15%, rgba(251,191,36,0.2) 0%, transparent 45%),
                    radial-gradient(ellipse at 75% 15%, rgba(168,85,247,0.12) 0%, transparent 45%);
      "></div>
      <div class="absolute inset-0 opacity-[0.06]" style="background-image: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22300%22 height=%22300%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22/></filter><rect width=%22300%22 height=%22300%22 filter=%22url(%23n)%22 opacity=%220.5%22/></svg>');"></div>
      <div class="absolute top-0 h-full w-px bg-amber-100/20" style="left: 23%;"></div>
      <div class="absolute top-0 h-full w-px bg-amber-100/15" style="left: 67%;"></div>
      <div class="absolute top-0 h-full w-0.5 bg-amber-100/10" style="left: 84%;"></div>
    </div>

    <%# ---- FLOATING EMBERS (warm dust motes drifting upward) ---- %>
    <div class="ember" style="width:3px;height:3px;background:rgba(251,191,36,0.7);bottom:20%;left:15%;animation-duration:12s;animation-delay:0s;"></div>
    <div class="ember" style="width:2px;height:2px;background:rgba(251,191,36,0.5);bottom:10%;left:35%;animation-duration:16s;animation-delay:2s;"></div>
    <div class="ember" style="width:4px;height:4px;background:rgba(168,85,247,0.5);bottom:25%;left:55%;animation-duration:14s;animation-delay:4s;"></div>
    <div class="ember" style="width:2px;height:2px;background:rgba(251,191,36,0.6);bottom:15%;left:70%;animation-duration:18s;animation-delay:1s;"></div>
    <div class="ember" style="width:3px;height:3px;background:rgba(168,85,247,0.4);bottom:30%;left:25%;animation-duration:20s;animation-delay:6s;"></div>
    <div class="ember" style="width:2px;height:2px;background:rgba(251,191,36,0.5);bottom:5%;left:80%;animation-duration:15s;animation-delay:3s;"></div>
    <div class="ember" style="width:3px;height:3px;background:rgba(251,191,36,0.4);bottom:18%;left:45%;animation-duration:22s;animation-delay:8s;"></div>
    <div class="ember" style="width:2px;height:2px;background:rgba(168,85,247,0.6);bottom:12%;left:60%;animation-duration:13s;animation-delay:5s;"></div>

    <%# ---- FILM DUST SPECS (old projector flicker — spread across full stage) ---- %>
    <%# Top band (above photo) %>
    <div class="dust-spec" style="width:3px;height:3px;background:rgba(251,191,36,1);top:8%;left:18%;animation-duration:2.2s;animation-delay:0.3s;"></div>
    <div class="dust-spec" style="width:2px;height:2px;background:rgba(255,220,150,0.9);top:12%;left:42%;animation-duration:3s;animation-delay:1.1s;"></div>
    <div class="dust-spec" style="width:2px;height:2px;background:rgba(251,191,36,0.9);top:6%;left:68%;animation-duration:2.5s;animation-delay:0.7s;"></div>
    <div class="dust-spec" style="width:3px;height:3px;background:rgba(255,255,255,0.8);top:14%;left:82%;animation-duration:3.2s;animation-delay:1.8s;"></div>
    <%# Left side %>
    <div class="dust-spec" style="width:2px;height:2px;background:rgba(251,191,36,0.9);top:35%;left:8%;animation-duration:2.8s;animation-delay:0.2s;"></div>
    <div class="dust-spec" style="width:3px;height:3px;background:rgba(255,220,150,1);top:55%;left:5%;animation-duration:2.4s;animation-delay:1.3s;"></div>
    <div class="dust-spec" style="width:1px;height:1px;background:rgba(255,255,255,0.9);top:75%;left:12%;animation-duration:3.5s;animation-delay:0.6s;"></div>
    <%# Right side %>
    <div class="dust-spec" style="width:2px;height:2px;background:rgba(251,191,36,0.9);top:40%;left:90%;animation-duration:2.6s;animation-delay:0.9s;"></div>
    <div class="dust-spec" style="width:3px;height:3px;background:rgba(255,255,255,0.8);top:62%;left:93%;animation-duration:3s;animation-delay:1.6s;"></div>
    <div class="dust-spec" style="width:2px;height:2px;background:rgba(255,220,150,1);top:80%;left:88%;animation-duration:2.3s;animation-delay:0.4s;"></div>
    <%# Bottom band (below photo) %>
    <div class="dust-spec" style="width:3px;height:3px;background:rgba(251,191,36,1);bottom:15%;left:22%;animation-duration:2.1s;animation-delay:1.4s;"></div>
    <div class="dust-spec" style="width:2px;height:2px;background:rgba(255,220,150,0.9);bottom:8%;left:50%;animation-duration:2.9s;animation-delay:0.5s;"></div>
    <div class="dust-spec" style="width:2px;height:2px;background:rgba(255,255,255,0.9);bottom:22%;left:72%;animation-duration:3.3s;animation-delay:1.9s;"></div>
    <div class="dust-spec" style="width:3px;height:3px;background:rgba(251,191,36,0.9);bottom:5%;left:35%;animation-duration:2.5s;animation-delay:0.1s;"></div>

    <%# ---- TITLE (flexbox child — sits at top, never overlaps image) ---- %>
    <div id="memcard-title" class="relative text-center px-6 pt-5 pb-2 md:pt-8 md:pb-3 flex-shrink-0 opacity-0 transition-opacity" style="z-index: 15; transition-duration: 1500ms;">
      <h1 class="text-2xl md:text-4xl lg:text-5xl font-bold tracking-wider text-white leading-tight" style="font-family: 'Bebas Neue', sans-serif; text-shadow: 0 0 40px rgba(168,85,247,0.5), 0 2px 20px rgba(0,0,0,0.8);">
        <%= @reflection.title || "A Memflection" %>
      </h1>
      <% if @reflection.name_for_recap.present? %>
        <p class="text-purple-300/70 text-xs md:text-sm mt-1 italic" style="font-family: 'Crimson Text', serif; text-shadow: 0 0 20px rgba(168,85,247,0.3);">
          a Memflection from <%= @reflection.name_for_recap %><% if @reflection.mode == "gift" && @reflection.recipient_name.present? %> for <%= @reflection.recipient_name %><% end %>
        </p>
      <% end %>
    </div>

    <%# ---- COVER IMAGE (flexbox child — centered in remaining space) ---- %>
    <div class="relative flex-1 flex items-center justify-center px-6 pb-4" style="z-index: 10;">
      <div class="relative">
        <div id="image-spotlight-glow"></div>
        <% if @reflection.cover_image.attached? %>
          <img id="memcard-image" src="<%= url_for(@reflection.cover_image) %>"
               class="rounded-xl object-contain opacity-0 transition-opacity"
               style="max-height: 55vh; max-width: 80vw; transition-duration: 2500ms;
                      filter: sepia(12%) contrast(115%) brightness(97%) saturate(120%) hue-rotate(-3deg);
                      border: 2px solid rgba(168,85,247,0.35);
                      box-shadow:
                        0 0 0 1px rgba(251,191,36,0.2),
                        0 0 40px rgba(168,85,247,0.5),
                        0 0 80px rgba(168,85,247,0.3),
                        0 0 120px rgba(168,85,247,0.15),
                        0 0 30px rgba(251,191,36,0.15),
                        0 40px 80px rgba(0,0,0,0.8),
                        0 0 200px rgba(0,0,0,0.4);">
        <% else %>
          <div id="memcard-image" class="rounded-xl bg-purple-950/40 border border-purple-500/20 flex items-center justify-center opacity-0 transition-opacity" style="width: 55vw; max-width: 380px; height: 45vh; max-height: 380px; transition-duration: 2500ms; box-shadow: 0 0 30px rgba(168,85,247,0.25), 0 0 60px rgba(168,85,247,0.12), 0 30px 60px rgba(0,0,0,0.7);">
            <p class="text-purple-300 text-6xl">🎭</p>
          </div>
        <% end %>
      </div>
    </div>

    <%# ---- PURPLE THEATER CURTAINS ---- %>
    <div id="curtain-left" class="absolute top-0 left-0 h-full w-1/2" style="z-index: 20; transition: transform 4.5s cubic-bezier(0.25, 0.46, 0.45, 0.94); background: linear-gradient(90deg, #1a0533 0%, #4c1d95 25%, #6b21a8 45%, #7e22ce 50%, #6b21a8 55%, #4c1d95 75%, #1a0533 100%); box-shadow: inset -20px 0 60px rgba(0,0,0,0.6), 5px 0 30px rgba(0,0,0,0.5);">
      <div class="absolute inset-0" style="background: repeating-linear-gradient(90deg, transparent 0px, transparent 28px, rgba(0,0,0,0.18) 28px, rgba(0,0,0,0.18) 30px, transparent 30px, transparent 58px, rgba(255,255,255,0.03) 58px, rgba(255,255,255,0.03) 60px);"></div>
      <div class="absolute bottom-0 left-0 right-0 h-10" style="background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);"></div>
    </div>

    <div id="curtain-right" class="absolute top-0 right-0 h-full w-1/2" style="z-index: 20; transition: transform 4.5s cubic-bezier(0.25, 0.46, 0.45, 0.94); background: linear-gradient(270deg, #1a0533 0%, #4c1d95 25%, #6b21a8 45%, #7e22ce 50%, #6b21a8 55%, #4c1d95 75%, #1a0533 100%); box-shadow: inset 20px 0 60px rgba(0,0,0,0.6), -5px 0 30px rgba(0,0,0,0.5);">
      <div class="absolute inset-0" style="background: repeating-linear-gradient(90deg, transparent 0px, transparent 28px, rgba(0,0,0,0.18) 28px, rgba(0,0,0,0.18) 30px, transparent 30px, transparent 58px, rgba(255,255,255,0.03) 58px, rgba(255,255,255,0.03) 60px);"></div>
      <div class="absolute bottom-0 left-0 right-0 h-10" style="background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);"></div>
    </div>

    <%# ---- AUTOPLAY FALLBACK ---- %>
    <div id="autoplay-tap" class="hidden absolute inset-0 flex items-center justify-center cursor-pointer" style="z-index: 50; background: rgba(0,0,0,0.6); backdrop-filter: blur(2px);">
      <div class="text-center">
        <div class="text-7xl mb-6 animate-pulse" style="filter: drop-shadow(0 0 30px rgba(168,85,247,0.5));">🎭</div>
        <p class="text-white text-3xl font-bold tracking-widest mb-2" style="font-family: 'Bebas Neue', sans-serif; text-shadow: 0 0 30px rgba(168,85,247,0.5);">Tap to Begin</p>
        <p class="text-purple-300/60 text-sm" style="font-family: 'Crimson Text', serif;">Your Memflection awaits</p>
      </div>
    </div>

    <%# ---- POST-AUDIO REVEAL ---- %>
    <div id="post-audio" class="hidden absolute inset-0 flex items-center justify-center px-4" style="z-index: 40; background: rgba(0,0,0,0.85); backdrop-filter: blur(4px);">
      <div class="max-w-sm w-full rounded-2xl border border-purple-500/20 p-6 md:p-8 text-center" style="background: linear-gradient(135deg, rgba(15,10,30,0.95), rgba(60,20,90,0.9), rgba(15,10,30,0.95)); box-shadow: 0 0 80px rgba(168,85,247,0.15), 0 25px 50px rgba(0,0,0,0.5);">
        <p class="text-5xl mb-4" style="filter: drop-shadow(0 0 20px rgba(168,85,247,0.4));">🎭</p>
        <h2 class="text-2xl md:text-3xl font-bold tracking-widest text-white mb-2" style="font-family: 'Bebas Neue', sans-serif;">A Moment to Reflect</h2>
        <p class="text-slate-400 text-sm mb-6" style="font-family: 'Crimson Text', serif;">
          Thank you for experiencing this Memflection.
        </p>
        <div class="space-y-3">
          <button onclick="replayMemcard()" class="w-full text-white font-medium tracking-wider py-3 px-6 rounded-lg transition-all hover:scale-[1.02] active:scale-[0.98]" style="background: linear-gradient(135deg, #7c3aed, #db2777); box-shadow: 0 4px 20px rgba(124,58,237,0.4);">
            🔁 Play Again
          </button>
          <button id="install-btn" onclick="promptInstall()" class="hidden w-full text-white font-medium tracking-wider py-3 px-6 rounded-lg transition-all hover:scale-[1.02] active:scale-[0.98]" style="background: linear-gradient(135deg, #059669, #10b981); box-shadow: 0 4px 20px rgba(5,150,105,0.3);">
            📱 Save to My Phone
          </button>
          <a href="<%= new_reflection_url(host: ENV.fetch("APP_HOST", "memflect.com")) %>" class="block w-full text-white font-medium tracking-wider py-3 px-6 rounded-lg transition-all hover:scale-[1.02] active:scale-[0.98]" style="background: linear-gradient(135deg, #0284c7, #2563eb); box-shadow: 0 4px 20px rgba(37,99,235,0.3);">
            ✨ Create My Own
          </a>
          <a href="<%= url_for(@reflection.extended_audio) %>" download class="block w-full text-slate-300 font-medium tracking-wider py-3 px-6 rounded-lg transition-all hover:bg-white/10" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
            💾 Download MP3
          </a>
        </div>
      </div>
    </div>

  </div>
  <%# ==================== END THEATER SCREEN ==================== %>


  <%# ==================== STAGE APRON (bottom control deck) ==================== %>
  <div id="stage-apron" class="relative flex-shrink-0" style="z-index: 25;">

    <%# ---- Stage edge lighting strip ---- %>
    <div class="w-full h-px" style="background: linear-gradient(90deg, transparent 5%, rgba(251,191,36,0.4) 20%, rgba(168,85,247,0.6) 50%, rgba(251,191,36,0.4) 80%, transparent 95%);"></div>
    <div class="w-full h-0.5" style="background: linear-gradient(90deg, transparent 10%, rgba(168,85,247,0.1) 30%, rgba(168,85,247,0.2) 50%, rgba(168,85,247,0.1) 70%, transparent 90%); filter: blur(2px);"></div>

    <%# ---- Stage floor ---- %>
    <div class="px-4 py-3" style="background: linear-gradient(to bottom, #08050f 0%, #0b0815 50%, #0e0b1a 100%);">
      <div class="max-w-xl mx-auto">

        <%# ---- Custom audio player ---- %>
        <div class="flex items-center gap-2.5 sm:gap-3 mb-2.5">
          <%# Play/Pause %>
          <button id="player-playpause" onclick="togglePlayPause()" class="flex-shrink-0 w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center rounded-full transition-all hover:scale-110 active:scale-95" style="background: linear-gradient(135deg, #7c3aed, #9333ea); box-shadow: 0 0 15px rgba(124,58,237,0.3);">
            <svg id="icon-play" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white ml-0.5" fill="currentColor" viewBox="0 0 20 20"><polygon points="5,3 18,10 5,17"/></svg>
            <svg id="icon-pause" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white hidden" fill="currentColor" viewBox="0 0 20 20"><rect x="4" y="3" width="4" height="14"/><rect x="12" y="3" width="4" height="14"/></svg>
          </button>

          <%# Time %>
          <span id="player-time" class="flex-shrink-0 text-[10px] sm:text-xs text-slate-500 font-mono tabular-nums">0:00 / 0:00</span>

          <%# Progress bar %>
          <div id="player-track" class="flex-1 h-8 flex items-center cursor-pointer group relative">
            <div class="w-full h-1 rounded-full overflow-hidden" style="background: rgba(255,255,255,0.08);">
              <div id="player-progress" class="h-full rounded-full" style="width: 0%; background: linear-gradient(90deg, #7c3aed, #a855f7); box-shadow: 0 0 8px rgba(168,85,247,0.5);"></div>
            </div>
            <div id="player-scrub" class="absolute top-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-white opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none" style="box-shadow: 0 0 10px rgba(168,85,247,0.6); left: 0;"></div>
          </div>

          <%# Fullscreen %>
          <button id="btn-fullscreen" onclick="toggleFullscreen()" class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-lg text-slate-500 hover:text-purple-400 transition-all hover:bg-white/5" title="Fullscreen">
            <svg id="icon-expand" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"/></svg>
            <svg id="icon-compress" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 14h6m0 0v6m0-6L3 21M20 10h-6m0 0V4m0 6l7-7"/></svg>
          </button>
        </div>

        <%# ---- CTA row ---- %>
        <div class="flex items-center justify-center gap-1">
          <a href="<%= url_for(@reflection.extended_audio) %>" download class="cta-link text-slate-500 hover:text-purple-400 py-1 px-2.5 rounded-lg transition-all hover:bg-white/5">
            Download
          </a>
          <span class="text-slate-700 text-xs">&middot;</span>
          <a href="<%= new_reflection_url(host: ENV.fetch("APP_HOST", "memflect.com")) %>" class="cta-link text-slate-500 hover:text-purple-400 py-1 px-2.5 rounded-lg transition-all hover:bg-white/5">
            Create Your Own
          </a>
          <span class="text-slate-700 text-xs">&middot;</span>
          <a href="https://memflect.com" class="cta-link text-slate-500 hover:text-purple-400 py-1 px-2.5 rounded-lg transition-all hover:bg-white/5">
            Memflect
          </a>
        </div>

      </div>
    </div>
  </div>
  <%# ==================== END STAGE APRON ==================== %>

  <%# ========== HIDDEN AUDIO ELEMENT ========== %>
  <audio id="memcard-audio" preload="auto">
    <source src="<%= url_for(@reflection.extended_audio) %>" type="audio/mpeg">
  </audio>

</div>


<script>
(function() {
  // ========== DOM REFS ==========
  var audio         = document.getElementById('memcard-audio');
  var curtainLeft   = document.getElementById('curtain-left');
  var curtainRight  = document.getElementById('curtain-right');
  var memcardImage  = document.getElementById('memcard-image');
  var memcardTitle  = document.getElementById('memcard-title');
  var postAudio     = document.getElementById('post-audio');
  var autoplayTap   = document.getElementById('autoplay-tap');
  var installBtn    = document.getElementById('install-btn');
  var filmFlicker   = document.getElementById('film-flicker');
  var spotConeL     = document.getElementById('spot-cone-left');
  var spotConeR     = document.getElementById('spot-cone-right');
  var spotSourceL   = document.getElementById('spot-source-left');
  var spotSourceR   = document.getElementById('spot-source-right');
  var imageGlow     = document.getElementById('image-spotlight-glow');

  var playerProgress = document.getElementById('player-progress');
  var playerScrub    = document.getElementById('player-scrub');
  var playerTrack    = document.getElementById('player-track');
  var playerTime     = document.getElementById('player-time');
  var iconPlay       = document.getElementById('icon-play');
  var iconPause      = document.getElementById('icon-pause');
  var iconExpand     = document.getElementById('icon-expand');
  var iconCompress   = document.getElementById('icon-compress');

  var deferredInstallPrompt = null;
  var curtainsOpened = false;
  var audioReady = false;
  var autoplayTimeout = null;

  // ========== UTILITIES ==========
  function fmt(sec) {
    if (isNaN(sec) || !isFinite(sec)) return '0:00';
    var m = Math.floor(sec / 60);
    var s = Math.floor(sec % 60);
    return m + ':' + (s < 10 ? '0' : '') + s;
  }

  // ========== SPOTLIGHT FLICKER ==========
  function flickerLoop() {
    var t = Date.now();
    // Left: purple, slow breathe + random jitter
    var lBase = 0.85 + 0.15 * Math.sin(t / 2200);
    var lJitter = (Math.random() - 0.5) * 0.15;
    var lVal = Math.max(0.3, Math.min(1, lBase + lJitter)).toFixed(3);
    spotConeL.style.opacity = lVal;
    spotSourceL.style.opacity = Math.min(1, parseFloat(lVal) + 0.1).toFixed(3);

    // Right: amber, offset cycle
    var rBase = 0.7 + 0.15 * Math.sin(t / 2800 + 1.5);
    var rJitter = (Math.random() - 0.5) * 0.12;
    var rVal = Math.max(0.2, Math.min(1, rBase + rJitter)).toFixed(3);
    spotConeR.style.opacity = rVal;
    spotSourceR.style.opacity = Math.min(1, parseFloat(rVal) + 0.1).toFixed(3);

    // Film flicker
    filmFlicker.style.opacity = (0.04 + Math.random() * 0.08).toFixed(3);

    requestAnimationFrame(flickerLoop);
  }
  flickerLoop();

  // ========== CURTAIN OPENING ==========
  function openCurtains() {
    if (curtainsOpened) return;
    curtainsOpened = true;
    curtainLeft.style.transform = 'translateX(-88%)';
    curtainRight.style.transform = 'translateX(88%)';
    // Title: mid-open reveal
    setTimeout(function() { memcardTitle.style.opacity = '1'; }, 2000);
    // Image: late reveal — listen first, see second
    setTimeout(function() {
      memcardImage.style.opacity = '1';
      if (imageGlow) imageGlow.style.opacity = '1';
    }, 3200);
  }

  // ========== AUTOPLAY — FIXED ==========
  audio.addEventListener('canplaythrough', function() {
    audioReady = true;
  }, { once: true });

  audio.addEventListener('playing', function onFirstPlay() {
    clearTimeout(autoplayTimeout);
    autoplayTap.classList.add('hidden');
    autoplayTap.classList.remove('flex');
    openCurtains();
    audio.removeEventListener('playing', onFirstPlay);
  });

  function tryAutoplay() {
    if (!audioReady) {
      autoplayTimeout = setTimeout(function() {
        if (!curtainsOpened) {
          autoplayTap.classList.remove('hidden');
          autoplayTap.classList.add('flex');
        }
      }, 6000);
      audio.addEventListener('canplaythrough', function() {
        audioReady = true;
        attemptPlay();
      }, { once: true });
      return;
    }
    attemptPlay();
  }

  function attemptPlay() {
    var p = audio.play();
    if (p !== undefined) {
      p.catch(function() {
        curtainsOpened = false;
        autoplayTap.classList.remove('hidden');
        autoplayTap.classList.add('flex');
      });
    }
  }

  autoplayTap.addEventListener('click', function() {
    curtainsOpened = false;
    audio.addEventListener('playing', function() {
      autoplayTap.classList.add('hidden');
      autoplayTap.classList.remove('flex');
      openCurtains();
    }, { once: true });
    audio.play();
  });

  window.addEventListener('load', function() {
    setTimeout(tryAutoplay, 600);
  });

  // ========== CUSTOM AUDIO PLAYER ==========
  audio.addEventListener('timeupdate', function() {
    if (!audio.duration) return;
    var pct = (audio.currentTime / audio.duration) * 100;
    playerProgress.style.width = pct + '%';
    playerTime.textContent = fmt(audio.currentTime) + ' / ' + fmt(audio.duration);
  });

  audio.addEventListener('loadedmetadata', function() {
    playerTime.textContent = '0:00 / ' + fmt(audio.duration);
  });

  function togglePlayPause() {
    if (audio.paused) { audio.play(); } else { audio.pause(); }
  }
  window.togglePlayPause = togglePlayPause;

  audio.addEventListener('play', function() {
    iconPlay.classList.add('hidden');
    iconPause.classList.remove('hidden');
  });
  audio.addEventListener('pause', function() {
    iconPause.classList.add('hidden');
    iconPlay.classList.remove('hidden');
  });

  // Seek
  function seekTo(e) {
    var rect = playerTrack.getBoundingClientRect();
    var pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
    if (audio.duration) {
      audio.currentTime = pct * audio.duration;
      playerProgress.style.width = (pct * 100) + '%';
    }
  }
  playerTrack.addEventListener('click', seekTo);

  var dragging = false;
  playerTrack.addEventListener('mousedown', function(e) { dragging = true; seekTo(e); });
  document.addEventListener('mousemove', function(e) {
    if (!dragging) return;
    seekTo(e);
    var rect = playerTrack.getBoundingClientRect();
    playerScrub.style.left = (Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width)) * 100) + '%';
  });
  document.addEventListener('mouseup', function() { dragging = false; });

  playerTrack.addEventListener('touchstart', function(e) { seekTo(e.touches[0]); }, { passive: true });
  playerTrack.addEventListener('touchmove', function(e) { seekTo(e.touches[0]); }, { passive: true });

  playerTrack.addEventListener('mousemove', function(e) {
    if (dragging) return;
    var rect = playerTrack.getBoundingClientRect();
    playerScrub.style.left = (Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width)) * 100) + '%';
  });

  // ========== POST-AUDIO ==========
  audio.addEventListener('ended', function() {
    curtainLeft.style.transform = 'translateX(0)';
    curtainRight.style.transform = 'translateX(0)';
    memcardImage.style.opacity = '0';
    memcardTitle.style.opacity = '0';
    if (imageGlow) imageGlow.style.opacity = '0';
    setTimeout(function() {
      postAudio.classList.remove('hidden');
      postAudio.classList.add('flex');
    }, 2500);
  });

  // ========== REPLAY ==========
  function replayMemcard() {
    postAudio.classList.add('hidden');
    postAudio.classList.remove('flex');
    curtainLeft.style.transform = 'translateX(0)';
    curtainRight.style.transform = 'translateX(0)';
    curtainsOpened = false;
    memcardTitle.style.opacity = '0';
    memcardImage.style.opacity = '0';
    if (imageGlow) imageGlow.style.opacity = '0';
    audio.currentTime = 0;
    audio.addEventListener('playing', function() { openCurtains(); }, { once: true });
    setTimeout(function() { audio.play(); }, 800);
  }
  window.replayMemcard = replayMemcard;

  // ========== FULLSCREEN ==========
  function toggleFullscreen() {
    if (!document.fullscreenElement && !document.webkitFullscreenElement) {
      var el = document.documentElement;
      if (el.requestFullscreen) { el.requestFullscreen(); }
      else if (el.webkitRequestFullscreen) { el.webkitRequestFullscreen(); }
    } else {
      if (document.exitFullscreen) { document.exitFullscreen(); }
      else if (document.webkitExitFullscreen) { document.webkitExitFullscreen(); }
    }
  }
  window.toggleFullscreen = toggleFullscreen;

  function updateFSIcon() {
    var isFS = !!(document.fullscreenElement || document.webkitFullscreenElement);
    iconExpand.classList.toggle('hidden', isFS);
    iconCompress.classList.toggle('hidden', !isFS);
  }
  document.addEventListener('fullscreenchange', updateFSIcon);
  document.addEventListener('webkitfullscreenchange', updateFSIcon);

  // ========== PWA INSTALL ==========
  window.addEventListener('beforeinstallprompt', function(e) {
    e.preventDefault();
    deferredInstallPrompt = e;
    installBtn.classList.remove('hidden');
  });

  function promptInstall() {
    var isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
    if (isIOS) {
      alert("To save this Memcard:\n\n1. Tap the Share button at the bottom\n2. Tap 'Add to Home Screen'\n3. Name it whatever you'd like");
      return;
    }
    if (deferredInstallPrompt) {
      deferredInstallPrompt.prompt();
      deferredInstallPrompt.userChoice.then(function() { deferredInstallPrompt = null; });
    } else {
      alert("Bookmark this page (Ctrl/Cmd+D) to save it for later!");
    }
  }
  window.promptInstall = promptInstall;

  var isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
  if (isIOS) installBtn.classList.remove('hidden');

})();
</script>
