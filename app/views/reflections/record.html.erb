<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<script>
  if (navigator.brave && navigator.brave.isBrave()) {
    window.addEventListener('DOMContentLoaded', () => {
      const warning = document.createElement('div');
      warning.className = 'bg-yellow-500/20 border-2 border-yellow-500 text-white px-6 py-4 rounded-xl mb-6 max-w-2xl mx-auto mt-20';
      warning.innerHTML = `
        <p class="font-semibold text-lg mb-2">⚠️ Brave Browser Detected</p>
        <p class="text-sm">Brave's privacy settings may block microphone access. If recording doesn't work, please try Safari or Chrome instead.</p>
      `;
      document.body.insertBefore(warning, document.body.firstChild);
    });
  }
</script>

<div class="min-h-screen flex items-center justify-center py-8 px-4 pt-16">
  <div class="max-w-2xl w-full space-y-6">

    <!-- STEP 1 -->
    <div class="text-center">
      <p class="text-slate-400 text-sm tracking-widest mb-2">STEP 1 OF 2</p>
      <h1 class="text-3xl md:text-4xl font-semibold tracking-wider text-white">
        Get Your Device Ready
      </h1>
    </div>

    <div class="bg-red-950/30 border border-red-700/40 text-white px-6 py-6 rounded-2xl">
      <p class="text-slate-300 text-sm text-center mb-4 tracking-widest">🎤 FOR BEST AUDIO QUALITY</p>
      <ul class="space-y-3 max-w-md mx-auto">
        <li class="flex items-start gap-3">
          <span class="text-red-400 mt-0.5 flex-shrink-0">•</span>
          <span class="text-base" style="font-family: 'Crimson Text', serif; text-transform: none; letter-spacing: normal;"><strong>Turn OFF Bluetooth</strong> — earbuds, headphones, speakers</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-red-400 mt-0.5 flex-shrink-0">•</span>
          <span class="text-base" style="font-family: 'Crimson Text', serif; text-transform: none; letter-spacing: normal;">Use your device's <strong>built-in microphone</strong></span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-red-400 mt-0.5 flex-shrink-0">•</span>
          <span class="text-base" style="font-family: 'Crimson Text', serif; text-transform: none; letter-spacing: normal;">Find a <strong>quiet space</strong> with minimal background noise</span>
        </li>
      </ul>
    </div>

    <!-- STEP 2 -->
    <div class="text-center pt-2">
      <p class="text-slate-400 text-sm tracking-widest mb-2">STEP 2 OF 2</p>
      <h1 class="text-3xl md:text-4xl font-semibold tracking-wider text-white">
        Record Your Voice
      </h1>
      <p class="text-slate-400 text-base mt-2" style="font-family: 'Crimson Text', serif; text-transform: none; letter-spacing: normal;">Speak slowly, clearly and naturally 😊</p>
    </div>

    <!-- Script Card -->
    <div class="bg-white/5 backdrop-blur-sm rounded-2xl border border-white/10 p-8">
      <p class="text-slate-400 text-xs text-center mb-5" style="font-family: 'Crimson Text', serif; text-transform: none; letter-spacing: normal;">✨ Read this aloud when you record</p>
      <div class="bg-black/20 rounded-xl p-6 border-l-4 border-purple-500/50 mb-6">
        <p class="text-white text-lg leading-relaxed" style="font-family: 'Crimson Text', serif; text-transform: none; letter-spacing: normal; font-style: italic;">
          "<%= @reflection.recap %>"
        </p>
      </div>
      <div class="text-center">
        <button id="recordButton" class="inline-block bg-green-600 hover:bg-green-500 text-white font-medium tracking-wider py-5 px-12 rounded-full focus:outline-none text-lg shadow-lg hover:shadow-green-500/50 transition-all">
          Start Recording
        </button>
        <p class="text-slate-500 text-xs mt-4" style="font-family: 'Crimson Text', serif; text-transform: none; letter-spacing: normal;">Tap once to start — tap again to stop and submit</p>
      </div>
    </div>

  </div>
</div>

<script>
  (function() {
    const recordButton = document.getElementById('recordButton');
    if (!recordButton) return;
    
    let mediaRecorder;
    let audioChunks = [];
    let mediaStream;

    const newButton = recordButton.cloneNode(true);
    recordButton.parentNode.replaceChild(newButton, recordButton);

    newButton.addEventListener('click', async () => {
      if (mediaRecorder && mediaRecorder.state === 'recording') {
        mediaRecorder.stop();
        newButton.textContent = 'Start Recording';
        newButton.classList.remove('bg-red-500', 'animate-pulse');
        newButton.classList.add('bg-green-600');
      } else {
        try {
          mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true });
          mediaRecorder = new MediaRecorder(mediaStream);
          audioChunks = [];

          mediaRecorder.ondataavailable = event => {
            audioChunks.push(event.data);
          };

          mediaRecorder.onstop = async () => {
            if (mediaStream) {
              mediaStream.getTracks().forEach(track => track.stop());
            }

            const mimeType = MediaRecorder.isTypeSupported('audio/webm') ? 'audio/webm' : 'audio/mp4';
            const extension = mimeType === 'audio/webm' ? 'webm' : 'mp4';
            const audioBlob = new Blob(audioChunks, { type: mimeType });
            const formData = new FormData();
            formData.append('audio', audioBlob, `recording.${extension}`);

            newButton.textContent = 'Uploading & Processing...';
            newButton.disabled = true;

            const response = await fetch('<%= receive_audio_reflection_path(@reflection) %>', {
              method: 'POST',
              body: formData,
              headers: {
                'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
              }
            });

            if (response.ok) {
              window.location.href = '<%= reflection_path(@reflection) %>';
            } else {
              console.error('Upload failed', response);
              newButton.textContent = 'Error - Try Again';
              newButton.disabled = false;
              alert('Upload failed. Please try again.');
            }
          };

          mediaRecorder.start();
          newButton.textContent = 'Stop Recording';
          newButton.classList.remove('bg-green-600');
          newButton.classList.add('bg-red-500', 'animate-pulse');

        } catch (error) {
          console.error('Error accessing microphone:', error);
          alert('Could not access the microphone. Please check your browser permissions.');
        }
      }
    });
  })();
</script>
