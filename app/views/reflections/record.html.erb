<div class="min-h-screen flex items-center justify-center py-12 px-4 pt-8">
  <div class="max-w-2xl w-full space-y-8">
    <div>
      <h1 class="text-center text-4xl font-extrabold text-white tracking-wide">
        Speak the Memflect Mantra (slow and clearly)
      </h1>
    </div>

    <!-- Audio Quality Warning Banner -->
    <div class="bg-yellow-500/20 border border-yellow-500/50 text-white px-6 py-4 rounded-xl mb-6">
      <p class="font-bold text-lg mb-2">🎤 For Best Audio Quality:</p>
      <ul class="text-sm space-y-1.5">
        <li>• <strong>Turn OFF Bluetooth</strong> (earbuds, headphones, speakers)</li>
        <li>• Use your device's built-in microphone</li>
        <li>• Find a quiet space with minimal background noise</li>
      </ul>
    </div>

    <div class="bg-black/50 backdrop-blur-xl p-8 rounded-2xl shadow-lg border border-white/20 text-center">
      <p class="mb-6 text-xl text-white font-bold leading-relaxed">
        "I, <%= @reflection.name_for_recap %>, am excited to begin using Memflect to transform my memories into personalized audio reflections. I understand how powerful it can be to truly listen to my own experiences, spoken in my own voice, and I'm ready to use this as a meaningful tool for self-understanding and growth in my daily life."
      </p>
      <button id="recordButton" class="bg-green-600 hover:bg-green-500 text-white font-bold py-4 px-8 rounded-full focus:outline-none focus:shadow-outline">
        Start Recording
      </button>
    </div>
  </div>
</div>

<script>
  (function() {
    const recordButton = document.getElementById('recordButton');
    if (!recordButton) return;
    
    let mediaRecorder;
    let audioChunks = [];
    let mediaStream;

    // Remove any existing listeners
    const newButton = recordButton.cloneNode(true);
    recordButton.parentNode.replaceChild(newButton, recordButton);

    newButton.addEventListener('click', async () => {
      if (mediaRecorder && mediaRecorder.state === 'recording') {
        mediaRecorder.stop();
        newButton.textContent = 'Start Recording';
        newButton.classList.remove('bg-red-500', 'animate-pulse');
        newButton.classList.add('bg-green-600');
      } else {
        try {
          mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true });
          mediaRecorder = new MediaRecorder(mediaStream);
          audioChunks = [];

          mediaRecorder.ondataavailable = event => {
            audioChunks.push(event.data);
          };

          mediaRecorder.onstop = async () => {
            // CRITICAL: Stop all media tracks immediately
            if (mediaStream) {
              mediaStream.getTracks().forEach(track => track.stop());
            }

            const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
            const formData = new FormData();
            formData.append('audio', audioBlob, 'recording.webm');

            newButton.textContent = 'Uploading & Processing...';
            newButton.disabled = true;

            const response = await fetch('<%= receive_audio_reflection_path(@reflection) %>', {
              method: 'POST',
              body: formData,
              headers: {
                'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
              }
            });

            if (response.ok) {
              window.location.href = '<%= reflection_path(@reflection) %>';
            } else {
              console.error('Upload failed', response);
              newButton.textContent = 'Error - Try Again';
              newButton.disabled = false;
              alert('Upload failed. Please try again.');
            }
          };

          mediaRecorder.start();
          newButton.textContent = 'Stop Recording';
          newButton.classList.remove('bg-green-600');
          newButton.classList.add('bg-red-500', 'animate-pulse');

        } catch (error) {
          console.error('Error accessing microphone:', error);
          alert('Could not access the microphone. Please check your browser permissions.');
        }
      }
    });
  })();
</script>