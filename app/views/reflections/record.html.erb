<div class="min-h-screen flex items-center justify-center py-8 px-4 pt-16">
  <div class="max-w-2xl w-full space-y-6">
    
    <!-- STEP 1 Header -->
    <div>
      <h1 class="text-center text-4xl font-semibold tracking-wider text-white">
        Step 1: Get Your Device Ready
      </h1>
    </div>
    
    <!-- Audio Quality Warning Banner - DARK CRIMSON -->
    <div class="bg-red-950/40 border-2 border-red-700/60 text-white px-8 py-8 rounded-xl max-w-2xl mx-auto">
      <p class="font-semibold tracking-wide text-2xl mb-6 text-center">🎤 For Best Audio Quality:</p>
      <ul class="text-lg space-y-3 text-left mx-auto" style="max-width: 36rem;">
        <li class="flex items-start">
          <span class="mr-2 flex-shrink-0 mt-0.5">•</span>
          <span><strong>Turn OFF Bluetooth</strong> (earbuds, headphones, speakers)</span>
        </li>
        <li class="flex items-start">
          <span class="mr-2 flex-shrink-0 mt-0.5">•</span>
          <span>Use your device's <strong>built-in microphone</strong></span>
        </li>
        <li class="flex items-start">
          <span class="mr-2 flex-shrink-0 mt-0.5">•</span>
          <span>Find a <strong>quiet space</strong> with minimal background noise</span>
        </li>
      </ul>
    </div>

    <!-- STEP 2 Header -->
    <div class="pt-4">
      <h1 class="text-center text-4xl font-semibold tracking-wider text-white">
        Step 2: Click Start Recording and Speak the Memflect Mantra
      </h1>
      <p class="text-center text-slate-300 text-lg mt-2 italic">(slowly, clearly & happy 😊)</p>
    </div>

    <!-- Recording Section -->
    <div class="bg-black/50 backdrop-blur-xl p-8 rounded-2xl shadow-lg border border-white/20 text-center">
      <p class="mb-6 text-lg text-white font-medium tracking-wide leading-relaxed">
        "I, <%= @reflection.name_for_recap %>, am exploring Memflect to see how it transforms my memories into personalized audio reflections. I'm curious what it will feel like to listen to my own experiences, spoken in my own voice—whether in the car, on a walk, before bed, or starting my day. I'm open to discovering how this could become a meaningful tool for self-understanding, growth and transformation."
      </p>
      <button id="recordButton" class="inline-block bg-green-600 hover:bg-green-500 text-white font-medium tracking-wider py-5 px-10 rounded-full focus:outline-none focus:shadow-outline text-lg shadow-lg hover:shadow-green-500/50 transition-all">
        Start Recording
      </button>
    </div>
  </div>
</div>

<script>
  (function() {
    const recordButton = document.getElementById('recordButton');
    if (!recordButton) return;
    
    let mediaRecorder;
    let audioChunks = [];
    let mediaStream;

    // Remove any existing listeners
    const newButton = recordButton.cloneNode(true);
    recordButton.parentNode.replaceChild(newButton, recordButton);

    newButton.addEventListener('click', async () => {
      if (mediaRecorder && mediaRecorder.state === 'recording') {
        mediaRecorder.stop();
        newButton.textContent = 'Start Recording';
        newButton.classList.remove('bg-red-500', 'animate-pulse');
        newButton.classList.add('bg-green-600');
      } else {
        try {
          mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true });
          mediaRecorder = new MediaRecorder(mediaStream);
          audioChunks = [];

          mediaRecorder.ondataavailable = event => {
            audioChunks.push(event.data);
          };

          mediaRecorder.onstop = async () => {
            // CRITICAL: Stop all media tracks immediately
            if (mediaStream) {
              mediaStream.getTracks().forEach(track => track.stop());
            }

            // iOS Safari uses mp4, others use webm
            const mimeType = MediaRecorder.isTypeSupported('audio/webm') ? 'audio/webm' : 'audio/mp4';
            const extension = mimeType === 'audio/webm' ? 'webm' : 'mp4';
            const audioBlob = new Blob(audioChunks, { type: mimeType });
            const formData = new FormData();
            formData.append('audio', audioBlob, `recording.${extension}`);

            newButton.textContent = 'Uploading & Processing...';
            newButton.disabled = true;

            const response = await fetch('<%= receive_audio_reflection_path(@reflection) %>', {
              method: 'POST',
              body: formData,
              headers: {
                'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
              }
            });

            if (response.ok) {
              window.location.href = '<%= reflection_path(@reflection) %>';
            } else {
              console.error('Upload failed', response);
              newButton.textContent = 'Error - Try Again';
              newButton.disabled = false;
              alert('Upload failed. Please try again.');
            }
          };

          mediaRecorder.start();
          newButton.textContent = 'Stop Recording';
          newButton.classList.remove('bg-green-600');
          newButton.classList.add('bg-red-500', 'animate-pulse');

        } catch (error) {
          console.error('Error accessing microphone:', error);
          alert('Could not access the microphone. Please check your browser permissions.');
        }
      }
    });
  })();
</script>