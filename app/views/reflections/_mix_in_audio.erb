<div class="text-center">
  <h1 class="text-4xl font-bold tracking-wider text-white tracking-wide">
    Mix in your Soundscape vibe
  </h1>
  <p class="mt-2 text-lg text-slate-300">
    Choose a soundscape to mix with your voice.
  </p>
</div>

<div class="bg-black/50 backdrop-blur-xl p-6 rounded-2xl shadow-lg border border-white/20">
  <%= form_with(model: reflection,
                url: mix_audio_reflection_path(reflection),
                method: :post,
                id: "mix-audio-form") do |form| %>
    <div class="space-y-4">
      
      <%= form.label :soundscape_id, "Choose your vibe:", class: "block text-white font-medium tracking-wide text-lg" %>
      
      <%= form.collection_select :soundscape_id,
                                  soundscapes,
                                  :id,
                                  :category,
                                  { prompt: "Select a vibe..." },
                                  id: "soundscape-select",
                                  class: "w-full bg-slate-800/50 text-white border-2 border-white/20 rounded-lg p-3 focus:outline-none focus:border-sky-400" %>

      <%= form.submit "Mix My Memflection",
                      id: "mix-submit-button",
                      class: "w-full bg-sky-600 hover:bg-sky-500 text-white font-medium tracking-wider py-3 px-4 rounded-lg cursor-pointer transition-all" %>
    </div>
  <% end %>
</div>

<script>
  (function() {
    const form = document.getElementById('mix-audio-form');
    const button = document.getElementById('mix-submit-button');
    const select = document.getElementById('soundscape-select');
    
    if (form && button) {
      form.addEventListener('submit', (e) => {
        if (!select.value) {
          e.preventDefault();
          alert('Please select a vibe first!');
          return;
        }
        
        button.disabled = true;
        button.classList.add('opacity-50', 'cursor-not-allowed');
        button.innerHTML = '🎛️ Mixing...';
      });
    }
  })();
</script>