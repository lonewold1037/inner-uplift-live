<%# ============================================================
    SECTION: BENEFITS
    File: app/views/pages/_section_benefits.html.erb
    ============================================================ %>

<section class="scroll-reveal" style="background: #faf7f2; padding: 5rem 1.5rem;">
  <div style="max-width: 960px; margin: 0 auto;">

    <div style="text-align: center; margin-bottom: 3.5rem;">
      <p style="font-family: 'Bebas Neue', sans-serif; font-size: 0.8rem; letter-spacing: 0.2em; color: #c9a84c; margin: 0 0 0.75rem;">WHAT WE ARE HERE TO HELP YOU WITH</p>
      <h2 style="font-family: 'Bebas Neue', sans-serif; font-size: clamp(2rem, 6vw, 3.5rem); letter-spacing: 0.03em; color: #1a0a2e; margin: 0; line-height: 1.05;">
        Some moments deserve more than a photo.
      </h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem;">

      <%# Benefit 1 %>
      <div style="background: white; border-radius: 24px; padding: 2.25rem; border: 1px solid rgba(201,168,76,0.2); box-shadow: 0 4px 24px rgba(26,10,46,0.06);">
        <div style="font-size: 2.5rem; margin-bottom: 1.25rem;">🎞️</div>
        <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem; letter-spacing: 0.06em; color: #1a0a2e; margin: 0 0 0.875rem;">
          Give your photos a voice
        </h3>
        <p style="font-family: 'Lora', serif; font-size: 0.95rem; color: #5a3e2b; text-transform: none; letter-spacing: normal; line-height: 1.8; margin: 0; opacity: 0.85;">
          Your camera roll is full of moments that meant everything — but sit there in silence. A Memflection adds your voice, your feelings, and music to bring them back to life. Yours to keep and replay forever.
        </p>
      </div>

      <%# Benefit 2 %>
      <div style="background: white; border-radius: 24px; padding: 2.25rem; border: 1px solid rgba(109,40,217,0.12); box-shadow: 0 4px 24px rgba(26,10,46,0.06);">
        <div style="font-size: 2.5rem; margin-bottom: 1.25rem;">🎁</div>
        <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem; letter-spacing: 0.06em; color: #1a0a2e; margin: 0 0 0.875rem;">
          The most personal thing you can send
        </h3>
        <p style="font-family: 'Lora', serif; font-size: 0.95rem; color: #5a3e2b; text-transform: none; letter-spacing: normal; line-height: 1.8; margin: 0; opacity: 0.85;">
          When someone you care about is going through something hard — or something wonderful — a Memflection says what a card never could. Your voice. Their photo. A cinematic moment they'll never forget.
        </p>
      </div>

      <%# Benefit 3 %>
      <div style="background: white; border-radius: 24px; padding: 2.25rem; border: 1px solid rgba(34,197,94,0.15); box-shadow: 0 4px 24px rgba(26,10,46,0.06);">
        <div style="font-size: 2.5rem; margin-bottom: 1.25rem;">🧠</div>
        <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem; letter-spacing: 0.06em; color: #1a0a2e; margin: 0 0 0.875rem;">
          Science-backed reflection
        </h3>
        <p style="font-family: 'Lora', serif; font-size: 0.95rem; color: #5a3e2b; text-transform: none; letter-spacing: normal; line-height: 1.8; margin: 0; opacity: 0.85;">
          Recalling positive memories lowers cortisol. Music activates the hippocampus and strengthens emotional processing. Structured reflection builds resilience. A Memflection does all three — in 5 minutes.
        </p>
      </div>

    </div>
  </div>
</section>
