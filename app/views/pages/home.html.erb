<%# ============================================================
    MEMFLECT — HOMEPAGE
    Add/remove sections by commenting/deleting render lines below.
    Swap campaign banner: change the 2 variables at the top.
    ============================================================ %>

<%# ── CAMPAIGN BANNER CONFIG ── %>
<% banner_text = "🎁 Father's Day is June 15" %>
<% banner_url  = new_reflection_path %>

<% content_for :head do %>
  <style>
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes shimmer {
      0%   { background-position: -200% center; }
      100% { background-position:  200% center; }
    }
    .scroll-reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .scroll-reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .gold-shimmer {
      background: linear-gradient(90deg, #c9a84c 0%, #f0d080 40%, #c9a84c 60%, #a07830 100%);
      background-size: 200% auto;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: shimmer 4s linear infinite;
    }
    .memflect-btn-primary {
      display: inline-block;
      background: #1a0a2e;
      color: white;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.2rem;
      letter-spacing: 0.1em;
      padding: 1rem 2.5rem;
      border-radius: 100px;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: opacity 0.2s;
    }
    .memflect-btn-primary:hover { opacity: 0.85; }
    .memflect-btn-ghost {
      display: inline-block;
      background: transparent;
      color: #1a0a2e;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.2rem;
      letter-spacing: 0.1em;
      padding: 1rem 2.5rem;
      border-radius: 100px;
      text-decoration: none;
      border: 2px solid rgba(26,10,46,0.2);
      cursor: pointer;
      transition: border-color 0.2s;
    }
    .memflect-btn-ghost:hover { border-color: rgba(26,10,46,0.5); }
  </style>
<% end %>

<div style="font-family: 'Lora', Georgia, serif; color: #1a0a2e; overflow-x: hidden;">

    <%# ── Campaign Banner — disabled. To re-enable, uncomment the render line below ── %>
    <%# render 'pages/section_banner' %>

  <%# ══════════════════════════════════════
      SECTIONS — comment out any to hide it
  ══════════════════════════════════════ %>
  <%= render 'pages/section_hero' %>
  <%= render 'pages/section_benefits' %>
  <%#= render 'pages/section_video' %>
  <%= render 'pages/section_social_proof' %>
  <%= render 'pages/section_faq' %>
  <%= render 'pages/section_about_creator' %>
  <%= render 'pages/section_cta' %>

</div>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.scroll-reveal').forEach(el => obs.observe(el));
</script>
