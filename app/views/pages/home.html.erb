              </thead>
              <tbody>
                <% [
                  ["Your own voice", true, false, false, false],
                  ["Personalised to your memory", true, true, false, false],
                  ["You choose the music", true, false, false, false],
                  ["Ready in 5 minutes", true, false, false, true],
                  ["One-time payment", true, true, false, false],
                  ["No subscription", true, true, false, false],
