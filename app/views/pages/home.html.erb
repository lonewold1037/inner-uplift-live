                    <td class="py-2 px-2 md:px-4 text-center text-base md:text-lg"><%= row[1] ? "✅" : "❌" %></td>
                    <td class="py-2 px-2 md:px-4 text-center text-base md:text-lg"><%= row[2] ? "✅" : "❌" %></td>
                    <td class="py-2 px-2 md:px-4 text-center text-base md:text-lg"><%= row[3] ? "✅" : "❌" %></td>
