<!-- iOS Install Instructions Banner (hidden by default) -->
<div id="ios-install-banner" class="hidden fixed top-0 left-0 right-0 bg-sky-600 text-white p-4 shadow-lg z-50">
  <div class="max-w-4xl mx-auto flex items-start justify-between">
    <div class="flex-1 text-sm tracking-wide">
      <p class="font-semibold tracking-wider mb-2">📱 INSTALL MEMFLECT</p>
      <p>Tap the <strong>Share button</strong> <svg class="inline w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M16 5l-1.42 1.42-1.59-1.59V16h-1.98V4.83L9.42 6.42 8 5l4-4 4 4zm4 5v11c0 1.1-.9 2-2 2H6c-1.11 0-2-.9-2-2V10c0-1.11.89-2 2-2h3v2H6v11h12V10h-3V8h3c1.1 0 2 .89 2 2z"/></svg> then <strong>"Add to Home Screen"</strong></p>
    </div>
    <button onclick="document.getElementById('ios-install-banner').classList.add('hidden')" class="text-white hover:text-gray-200 ml-4 text-xl">✕</button>
  </div>
</div>

<div class="min-h-screen flex flex-col items-center justify-center text-center p-8 pt-16 relative">
  <div class="max-w-3xl">

    <!-- Floating Animated Logo -->
    <div class="relative mb-8">
      <h1 class="text-5xl md:text-7xl font-bold tracking-wider text-white relative z-10 whitespace-nowrap">
        <span class="inline-block animate-float" style="animation-delay: 0s;">M</span>
        <span class="inline-block animate-float" style="animation-delay: 0.1s;">E</span>
        <span class="inline-block animate-float" style="animation-delay: 0.2s;">M</span>
        <span class="inline-block animate-float" style="animation-delay: 0.3s;">F</span>
        <span class="inline-block animate-float" style="animation-delay: 0.4s;">L</span>
        <span class="inline-block animate-float" style="animation-delay: 0.5s;">E</span>
        <span class="inline-block animate-float" style="animation-delay: 0.6s;">C</span>
        <span class="inline-block animate-float" style="animation-delay: 0.7s;">T</span>
      </h1>
      <div class="absolute inset-0 blur-3xl bg-gradient-to-r from-purple-500 via-pink-500 to-sky-500 opacity-30 animate-pulse -z-10"></div>
    </div>

    <p class="mt-6 text-2xl text-slate-200 font-light tracking-wide">
      Turn your memories into transformative audio reflections, spoken in your own voice.
    </p>

    <!-- Show button for EVERYONE (guests and logged-in users) -->
    <div class="mt-12 text-center">
      <%= link_to "Start my Memflection", new_reflection_path, class: "inline-block bg-gradient-to-r from-sky-600 to-blue-600 hover:from-sky-500 hover:to-blue-500 text-white font-medium tracking-widest py-5 px-10 rounded-xl shadow-2xl text-xl transform hover:scale-105 transition-all duration-300" %>
      
      <!-- Android Install Button (hidden by default, only for guests) -->
      <% unless user_signed_in? %>
        <div id="android-install-button" class="hidden mt-6">
          <button onclick="installPWA()" class="inline-block bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-500 hover:to-emerald-500 text-white font-medium tracking-widest py-4 px-8 rounded-xl shadow-2xl text-lg transform hover:scale-105 transition-all duration-300">
            📱 Install App
          </button>
        </div>
      <% end %>
    </div>

    <!-- Science Behind It Banner -->
    <div class="mt-16 max-w-2xl mx-auto">
      <div class="bg-white/5 backdrop-blur-sm rounded-2xl border border-white/10 p-8 relative">
        
        <!-- Science Sources Button -->
        <button onclick="document.getElementById('science-modal').classList.remove('hidden')" class="absolute top-4 right-4 text-slate-400 hover:text-white text-sm flex items-center gap-1 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Sources
        </button>

        <!-- Header -->
        <h2 class="text-xl md:text-2xl font-semibold text-white text-center mb-8 tracking-wide">The Science Behind Memflect</h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-slate-300">
          
          <div class="text-center">
            <div class="text-4xl mb-4">🧠</div>
            <h3 class="text-white font-semibold tracking-wider mb-3 uppercase">Neural Pathways</h3>
            <p class="text-sm leading-relaxed">Self-referential processing (hearing yourself) activates the medial prefrontal cortex, which is crucial for autobiographical memory and self-awareness.</p>
          </div>
          
          <div class="text-center">
            <div class="text-4xl mb-4">💭</div>
            <h3 class="text-white font-semibold tracking-wider mb-3 uppercase">Emotional Regulation</h3>
            <p class="text-sm leading-relaxed">Ambient music engages the limbic system (amygdala, hippocampus), reducing stress hormones while enhancing memory consolidation.</p>
          </div>
          
          <div class="text-center">
            <div class="text-4xl mb-4">🌱</div>
            <h3 class="text-white font-semibold tracking-wider mb-3 uppercase">Reflective Growth</h3>
            <p class="text-sm leading-relaxed">Structured reflection on difficult & positive experiences has been shown to increase resilience, meaning-making, and personal growth.</p>
          </div>
          
        </div>
      </div>
    </div>

    <!-- Secondary CTA -->
    <div class="mt-8">
      <%= link_to "Let Me Try 30 Seconds for Free!", new_reflection_path, class: "inline-block text-sky-400 hover:text-sky-300 font-medium tracking-wide text-lg underline decoration-2 underline-offset-4 transition-colors" %>
    </div>

  </div>
</div>

<!-- Science Sources Modal -->
<div id="science-modal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-slate-900 rounded-2xl max-w-2xl w-full p-8 relative border border-white/10 max-h-[80vh] overflow-y-auto">
    <button onclick="document.getElementById('science-modal').classList.add('hidden')" class="absolute top-4 right-4 text-slate-400 hover:text-white text-2xl">✕</button>
    
    <h2 class="text-2xl font-bold text-white mb-6">Further Reading</h2>
    
    <div class="space-y-6 text-slate-300 text-sm">
      <div>
        <h3 class="font-semibold text-white mb-2 uppercase">🧠 Neural Pathways</h3>
        <p class="mb-2">Self-referential processing activates the medial prefrontal cortex, enhancing autobiographical memory encoding and self-awareness.</p>
        <a href="https://pubmed.ncbi.nlm.nih.gov/16439281/" target="_blank" class="text-sky-400 hover:text-sky-300 underline block mb-1">Northoff & Bermpohl (2004) - Cortical Midline Structures and the Self</a>
        <a href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC2605405/" target="_blank" class="text-sky-400 hover:text-sky-300 underline block">Kelley et al. (2002) - Finding the Self? An Event-Related fMRI Study</a>
      </div>
      
      <div>
        <h3 class="font-semibold text-white mb-2 uppercase">💭 Emotional Regulation</h3>
        <p class="mb-2">Music activates limbic and paralimbic brain areas, reducing cortisol levels and enhancing emotional processing during reflection.</p>
        <a href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3741536/" target="_blank" class="text-sky-400 hover:text-sky-300 underline block mb-1">Chanda & Levitin (2013) - The Neurochemistry of Music</a>
        <a href="https://pubmed.ncbi.nlm.nih.gov/21147893/" target="_blank" class="text-sky-400 hover:text-sky-300 underline block">Blood & Zatorre (2001) - Intensely Pleasurable Responses to Music</a>
      </div>
      
      <div>
        <h3 class="font-semibold text-white mb-2 uppercase">🌱 Reflective Growth</h3>
        <p class="mb-2">Structured reflection on meaningful experiences promotes post-traumatic growth, resilience, and psychological well-being.</p>
        <a href="https://psycnet.apa.org/record/2004-16727-002" target="_blank" class="text-sky-400 hover:text-sky-300 underline block mb-1">Tedeschi & Calhoun (2004) - Post-Traumatic Growth: Conceptual Foundations</a>
        <a href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3951958/" target="_blank" class="text-sky-400 hover:text-sky-300 underline block">Pennebaker & Chung (2011) - Expressive Writing and Health</a>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes float {
    0%, 100% { 
      transform: translateY(0px) rotateY(0deg);
      text-shadow: 0 0 20px rgba(147, 51, 234, 0.5);
    }
    50% { 
      transform: translateY(-20px) rotateY(10deg);
      text-shadow: 0 0 40px rgba(147, 51, 234, 0.8);
    }
  }
  
  .animate-float {
    animation: float 3s ease-in-out infinite;
    display: inline-block;
  }
</style>

<script>
  // PWA Install Detection
  let deferredPrompt;
  
  window.addEventListener('load', () => {
    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
    const isAndroid = /Android/.test(navigator.userAgent);
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;
    
    // Don't show prompts if already installed
    if (isStandalone) {
      return;
    }
    
    // Show iOS instructions
    if (isIOS) {
      document.getElementById('ios-install-banner').classList.remove('hidden');
    }
    
    // Show Android install button when prompt is available
    if (isAndroid) {
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        document.getElementById('android-install-button').classList.remove('hidden');
      });
    }
  });
  
  // Android install function
  function installPWA() {
    if (deferredPrompt) {
      deferredPrompt.prompt();
      deferredPrompt.userChoice.then((choiceResult) => {
        if (choiceResult.outcome === 'accepted') {
          console.log('PWA installed');
        }
        deferredPrompt = null;
      });
    }
  }
</script>