<%# ============================================================
    MEMFLECT — NEW HOMEPAGE (Gift-First)
    Replace: app/views/pages/home.html.erb
    ============================================================ %>

<%# Override the dark global background for this page only %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<script>
  document.body.classList.add('page-home');
  document.addEventListener('turbo:before-visit', () => {
    document.body.classList.remove('page-home');
  });
</script>

<%# ── iOS Install Banner ─────────────────────────────────────── %>
<div id="ios-install-banner" class="hidden fixed top-0 left-0 right-0 z-50" style="background: #6d28d9; color: white; padding: 1rem; box-shadow: 0 2px 20px rgba(109,40,217,0.3);">
  <div style="max-width: 600px; margin: 0 auto; display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
    <p style="font-family: 'Lora', serif; font-size: 0.9rem; text-transform: none; letter-spacing: normal; margin: 0;">
      📱 Tap the <strong>Share button</strong> then <strong>"Add to Home Screen"</strong> to install Memflect.
    </p>
    <button onclick="document.getElementById('ios-install-banner').classList.add('hidden')" style="background: none; border: none; color: white; font-size: 1.2rem; cursor: pointer; flex-shrink: 0;">✕</button>
  </div>
</div>

<div style="font-family: 'Lora', serif; color: #1e1b4b; overflow-x: hidden;">

  <%# ══════════════════════════════════════════════════════════
      SECTION 1 — HERO
  ══════════════════════════════════════════════════════════ %>
  <section style="min-height: 90vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 5rem 1.5rem 3rem; background: linear-gradient(160deg, #fdf6ff 0%, #fce7f3 40%, #ede9fe 100%); position: relative; overflow: hidden;">

    <%# Background decoration %>
    <div style="position: absolute; top: -80px; right: -80px; width: 400px; height: 400px; background: radial-gradient(circle, rgba(244,114,182,0.15) 0%, transparent 70%); pointer-events: none;"></div>
    <div style="position: absolute; bottom: -60px; left: -60px; width: 300px; height: 300px; background: radial-gradient(circle, rgba(109,40,217,0.12) 0%, transparent 70%); pointer-events: none;"></div>

    <%# Occasion badge %>
    <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: white; border: 1.5px solid rgba(244,114,182,0.4); border-radius: 100px; padding: 0.4rem 1rem; margin-bottom: 2rem; box-shadow: 0 2px 12px rgba(244,114,182,0.15);">
      <span style="font-size: 1rem;">💐</span>
      <span style="font-family: 'Lora', serif; font-size: 0.8rem; color: #be185d; text-transform: none; letter-spacing: 0.05em;">Mother's Day is May 11 — order now</span>
    </div>

    <%# Main headline %>
    <h1 style="font-family: 'Bebas Neue', sans-serif; font-size: clamp(3rem, 10vw, 6.5rem); line-height: 1; letter-spacing: 0.04em; color: #3b0764; margin: 0 0 1.5rem; max-width: 900px;">
      The gift that says<br>
      <span style="color: #be185d;">what you couldn't.</span>
    </h1>

    <p style="font-size: clamp(1.1rem, 2.5vw, 1.35rem); color: #4c1d95; max-width: 560px; line-height: 1.7; margin: 0 auto 2.5rem; text-transform: none; letter-spacing: normal; font-weight: 400;">
      Turn a memory into a cinematic audio gift — narrated in <em>your own voice</em>, set to music, with their photo. Delivered as a beautiful reveal they'll never forget.
    </p>

    <%# Price anchor %>
    <p style="font-family: 'Lora', serif; font-size: 0.9rem; color: #7c3aed; text-transform: none; letter-spacing: normal; margin-bottom: 1.2rem; opacity: 0.8;">
      Less than a coffee. ☕ Remembered forever.
    </p>

    <%# Primary CTA %>
    <%= link_to new_reflection_path, style: "display: inline-block; background: linear-gradient(135deg, #7c3aed 0%, #be185d 100%); color: white; font-family: 'Bebas Neue', sans-serif; font-size: 1.4rem; letter-spacing: 0.1em; padding: 1.1rem 3rem; border-radius: 100px; text-decoration: none; box-shadow: 0 8px 30px rgba(124,58,237,0.35); transition: all 0.2s; margin-bottom: 1rem;" do %>
      Create a Gift — $3.99 →
    <% end %>

    <%# Android install button %>
    <% unless user_signed_in? %>
      <div id="android-install-button" class="hidden" style="margin-top: 1rem;">
        <button onclick="installPWA()" style="display: inline-block; background: white; border: 2px solid #7c3aed; color: #7c3aed; font-family: 'Bebas Neue', sans-serif; font-size: 1rem; letter-spacing: 0.08em; padding: 0.8rem 2rem; border-radius: 100px; cursor: pointer;">
          📱 Install App
        </button>
      </div>
    <% end %>

    <%# Scroll nudge %>
    <div style="margin-top: 3rem; animation: bounce 2s infinite;">
      <span style="color: #a78bfa; font-size: 1.5rem;">↓</span>
    </div>
  </section>

  <%# ══════════════════════════════════════════════════════════
      SECTION 2 — THE FORMULA
  ══════════════════════════════════════════════════════════ %>
  <section style="background: white; padding: 4rem 1.5rem; text-align: center;">
    <p style="font-family: 'Bebas Neue', sans-serif; font-size: 0.9rem; letter-spacing: 0.2em; color: #a78bfa; margin-bottom: 2rem;">HOW IT WORKS</p>

    <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.75rem; max-width: 800px; margin: 0 auto 2.5rem;">
      <div style="text-align: center; padding: 1rem 1.25rem; background: #fdf4ff; border-radius: 16px; border: 1.5px solid #e9d5ff; min-width: 120px;">
        <div style="font-size: 2.5rem; margin-bottom: 0.4rem;">📸</div>
        <div style="font-family: 'Lora', serif; font-size: 0.8rem; color: #6d28d9; text-transform: none; letter-spacing: normal; font-weight: 600;">Their photo</div>
      </div>
      <div style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; color: #d8b4fe;">+</div>
      <div style="text-align: center; padding: 1rem 1.25rem; background: #fff0f6; border-radius: 16px; border: 1.5px solid #fbcfe8; min-width: 120px;">
        <div style="font-size: 2.5rem; margin-bottom: 0.4rem;">🎤</div>
        <div style="font-family: 'Lora', serif; font-size: 0.8rem; color: #be185d; text-transform: none; letter-spacing: normal; font-weight: 600;">Your voice</div>
      </div>
      <div style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; color: #d8b4fe;">+</div>
      <div style="text-align: center; padding: 1rem 1.25rem; background: #f0fdf4; border-radius: 16px; border: 1.5px solid #bbf7d0; min-width: 120px;">
        <div style="font-size: 2.5rem; margin-bottom: 0.4rem;">🎵</div>
        <div style="font-family: 'Lora', serif; font-size: 0.8rem; color: #15803d; text-transform: none; letter-spacing: normal; font-weight: 600;">Sweet music</div>
      </div>
      <div style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; color: #d8b4fe;">+</div>
      <div style="text-align: center; padding: 1rem 1.25rem; background: #fefce8; border-radius: 16px; border: 1.5px solid #fde68a; min-width: 120px;">
        <div style="font-size: 2.5rem; margin-bottom: 0.4rem;">✨</div>
        <div style="font-family: 'Lora', serif; font-size: 0.8rem; color: #92400e; text-transform: none; letter-spacing: normal; font-weight: 600;">Memflect magic</div>
      </div>
      <div style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; color: #be185d;">=</div>
      <div style="text-align: center; padding: 1rem 1.5rem; background: linear-gradient(135deg, #7c3aed, #be185d); border-radius: 16px; min-width: 140px; box-shadow: 0 8px 25px rgba(124,58,237,0.25);">
        <div style="font-size: 2.5rem; margin-bottom: 0.4rem;">🎁</div>
        <div style="font-family: 'Lora', serif; font-size: 0.8rem; color: white; text-transform: none; letter-spacing: normal; font-weight: 600;">A gift they'll cry over</div>
      </div>
    </div>
  </section>

  <%# ══════════════════════════════════════════════════════════
      SECTION 3 — THE REVEAL (A/V PLACEHOLDER)
  ══════════════════════════════════════════════════════════ %>
  <section style="background: #1e1b4b; padding: 5rem 1.5rem; text-align: center;">
    <p style="font-family: 'Bebas Neue', sans-serif; font-size: 0.9rem; letter-spacing: 0.2em; color: #a78bfa; margin-bottom: 1rem;">THE GIFT REVEAL</p>
    <h2 style="font-family: 'Bebas Neue', sans-serif; font-size: clamp(2rem, 6vw, 3.5rem); color: white; letter-spacing: 0.04em; margin: 0 0 1rem;">This is what they receive.</h2>
    <p style="font-family: 'Lora', serif; font-size: 1rem; color: #c4b5fd; text-transform: none; letter-spacing: normal; margin-bottom: 3rem; max-width: 500px; margin-left: auto; margin-right: auto;">
      They tap a link. Purple curtains open. Their photo fades in. Your voice begins. 5 cinematic minutes — just for them.
    </p>

    <%#
    ══════════════════════════════════════════════════
    📹 A/V PLACEHOLDER — THE REVEAL VIDEO
    ══════════════════════════════════════════════════

    OPTION A (Recommended): Screen-record yourself opening a
    gift reveal link on your phone. Capture:
      1. Tapping the link from a text message
      2. The purple velvet curtain opening
      3. The photo fading in
      4. ~15 seconds of the audio playing with your face reacting

    Export as MP4 at 9:16 (vertical) or 16:9 (horizontal).
    Save to: public/videos/reveal-demo.mp4

    Then REPLACE the placeholder div below with:
    <video autoplay muted loop playsinline
           style="width:100%;max-width:600px;border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,0.5);">
      <source src="/videos/reveal-demo.mp4" type="video/mp4">
    </video>

    OPTION B (Quick): Take a screenshot of the reveal page
    (already done — use the "Jester's Legacy" screenshot or similar).
    Save to: public/images/reveal-screenshot.png

    Then REPLACE the placeholder div below with:
    <img src="/images/reveal-screenshot.png"
         alt="Memflect gift reveal"
         style="width:100%;max-width:600px;border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,0.5);">

    OPTION C (Even quicker): Embed your existing YouTube video.
    Replace YOUR_VIDEO_ID below with the actual video ID.
    ══════════════════════════════════════════════════
    %>

    <%# PLACEHOLDER — replace with video/screenshot/embed per instructions above %>
    <div style="max-width: 600px; margin: 0 auto; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.5); background: #2d1b69; border: 1px solid rgba(167,139,250,0.3); padding: 3rem 2rem; position: relative;">
      <div style="width: 60px; height: 60px; background: rgba(167,139,250,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; border: 2px solid rgba(167,139,250,0.4);">
        <span style="font-size: 1.5rem;">🎬</span>
      </div>
      <p style="font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; letter-spacing: 0.1em; color: #a78bfa; margin-bottom: 0.75rem;">[ REVEAL VIDEO GOES HERE ]</p>
      <p style="font-family: 'Lora', serif; font-size: 0.85rem; color: #7c6fa0; text-transform: none; letter-spacing: normal; line-height: 1.6;">
        Screen-record the purple curtain reveal on your phone and drop it here.<br>
        See the comments in the code above for exact instructions.
      </p>
    </div>

    <%# Fallback: keep YouTube video as secondary option below the main placeholder %>
    <div style="max-width: 600px; margin: 2rem auto 0;">
      <p style="font-family: 'Lora', serif; font-size: 0.8rem; color: #7c6fa0; text-transform: none; letter-spacing: normal; margin-bottom: 1rem;">Or watch the full walkthrough:</p>
      <div style="position: relative; padding-bottom: 56.25%; border-radius: 12px; overflow: hidden;">
        <iframe
          style="position:absolute;top:0;left:0;width:100%;height:100%;"
          src="https://www.youtube.com/embed/PHPOoJCdiII"
          title="What is Memflect?"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen>
        </iframe>
      </div>
    </div>
  </section>

  <%# ══════════════════════════════════════════════════════════
      SECTION 4 — OCCASIONS STRIP
  ══════════════════════════════════════════════════════════ %>
  <section style="background: white; padding: 3.5rem 1.5rem; text-align: center;">
    <p style="font-family: 'Bebas Neue', sans-serif; font-size: 0.9rem; letter-spacing: 0.2em; color: #a78bfa; margin-bottom: 2rem;">PERFECT FOR</p>
    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; max-width: 700px; margin: 0 auto;">
      <% [
        ["💐", "Mother's Day"],
        ["🎂", "Birthdays"],
        ["💍", "Anniversaries"],
        ["🎓", "Graduations"],
        ["💛", "Just Because"],
        ["🙏", "Thank You"],
        ["💔", "Grief & Loss"],
        ["🎄", "Christmas"]
      ].each do |emoji, label| %>
        <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #fdf4ff; border: 1.5px solid #e9d5ff; border-radius: 100px; padding: 0.6rem 1.2rem;">
          <span style="font-size: 1.1rem;"><%= emoji %></span>
          <span style="font-family: 'Lora', serif; font-size: 0.85rem; color: #6d28d9; text-transform: none; letter-spacing: normal; font-weight: 600;"><%= label %></span>
        </div>
      <% end %>
    </div>
  </section>

  <%# ══════════════════════════════════════════════════════════
      SECTION 5 — HOW IT WORKS (3 STEPS)
  ══════════════════════════════════════════════════════════ %>
  <section style="background: linear-gradient(160deg, #fdf6ff 0%, #fce7f3 100%); padding: 5rem 1.5rem; text-align: center;">
    <p style="font-family: 'Bebas Neue', sans-serif; font-size: 0.9rem; letter-spacing: 0.2em; color: #a78bfa; margin-bottom: 1rem;">TAKES ABOUT 5 MINUTES</p>
    <h2 style="font-family: 'Bebas Neue', sans-serif; font-size: clamp(2rem, 6vw, 3rem); color: #3b0764; letter-spacing: 0.04em; margin: 0 0 3rem;">Three steps. One unforgettable gift.</h2>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; max-width: 800px; margin: 0 auto 3rem;">
      <div style="background: white; border-radius: 20px; padding: 2rem 1.5rem; box-shadow: 0 4px 20px rgba(109,40,217,0.08); border: 1px solid rgba(109,40,217,0.08); text-align: left;">
        <div style="font-size: 2rem; margin-bottom: 1rem;">✍️</div>
        <div style="font-family: 'Bebas Neue', sans-serif; font-size: 0.75rem; letter-spacing: 0.15em; color: #a78bfa; margin-bottom: 0.5rem;">STEP 1</div>
        <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem; color: #3b0764; letter-spacing: 0.04em; margin: 0 0 0.75rem;">Write the memory</h3>
        <p style="font-family: 'Lora', serif; font-size: 0.9rem; color: #6d28d9; text-transform: none; letter-spacing: normal; line-height: 1.7; opacity: 0.8; margin: 0;">4 simple fields. What happened, how it felt, why it mattered, and what you want them to carry forward. Upload their photo.</p>
      </div>

      <div style="background: white; border-radius: 20px; padding: 2rem 1.5rem; box-shadow: 0 4px 20px rgba(190,24,93,0.08); border: 1px solid rgba(190,24,93,0.08); text-align: left;">
        <div style="font-size: 2rem; margin-bottom: 1rem;">🎤</div>
        <div style="font-family: 'Bebas Neue', sans-serif; font-size: 0.75rem; letter-spacing: 0.15em; color: #f9a8d4; margin-bottom: 0.5rem;">STEP 2</div>
        <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem; color: #3b0764; letter-spacing: 0.04em; margin: 0 0 0.75rem;">Record your voice</h3>
        <p style="font-family: 'Lora', serif; font-size: 0.9rem; color: #be185d; text-transform: none; letter-spacing: normal; line-height: 1.7; opacity: 0.8; margin: 0;">Read a short script aloud. Just once. Memflect clones your voice and turns it into a full 5-minute cinematic narration.</p>
      </div>

      <div style="background: white; border-radius: 20px; padding: 2rem 1.5rem; box-shadow: 0 4px 20px rgba(109,40,217,0.08); border: 1px solid rgba(109,40,217,0.08); text-align: left;">
        <div style="font-size: 2rem; margin-bottom: 1rem;">📤</div>
        <div style="font-family: 'Bebas Neue', sans-serif; font-size: 0.75rem; letter-spacing: 0.15em; color: #a78bfa; margin-bottom: 0.5rem;">STEP 3</div>
        <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem; color: #3b0764; letter-spacing: 0.04em; margin: 0 0 0.75rem;">Send the link</h3>
        <p style="font-family: 'Lora', serif; font-size: 0.9rem; color: #6d28d9; text-transform: none; letter-spacing: normal; line-height: 1.7; opacity: 0.8; margin: 0;">They tap your link. Purple curtains open. Their photo appears. Your voice begins. They cry. You're the best gift-giver they know.</p>
      </div>
    </div>

    <%= link_to new_reflection_path, style: "display: inline-block; background: linear-gradient(135deg, #7c3aed 0%, #be185d 100%); color: white; font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem; letter-spacing: 0.1em; padding: 1rem 2.5rem; border-radius: 100px; text-decoration: none; box-shadow: 0 8px 30px rgba(124,58,237,0.3);" do %>
      Start Creating — $3.99 →
    <% end %>
  </section>

  <%# ══════════════════════════════════════════════════════════
      SECTION 6 — TESTIMONIAL
  ══════════════════════════════════════════════════════════ %>
  <section style="background: white; padding: 5rem 1.5rem; text-align: center;">
    <p style="font-family: 'Bebas Neue', sans-serif; font-size: 0.9rem; letter-spacing: 0.2em; color: #a78bfa; margin-bottom: 1rem;">REAL REACTIONS</p>
    <h2 style="font-family: 'Bebas Neue', sans-serif; font-size: clamp(1.8rem, 5vw, 2.8rem); color: #3b0764; letter-spacing: 0.04em; margin: 0 0 2.5rem;">They didn't expect it to hit this hard.</h2>

    <%#
    ══════════════════════════════════════════════════
    📸 A/V PLACEHOLDER — TESTIMONIAL SCREENSHOTS
    ══════════════════════════════════════════════════

    Add your best 2-3 reaction screenshots here.
    These can be:
      - WhatsApp/iMessage screenshots of people's reactions
      - Written testimonials from Andy, Tifani, Schyler, Dan etc.
      - Video reaction clips (see Option B below)

    OPTION A (Screenshots — recommended for now):
    Save screenshots to: public/images/testimonials/
    Name them: t1.png, t2.png, t3.png

    Then replace the placeholder divs below with:
    <img src="/images/testimonials/t1.png"
         alt="Customer reaction"
         style="max-width:400px;width:100%;border-radius:16px;box-shadow:0 8px 30px rgba(109,40,217,0.12);">

    OPTION B (Video reactions — gold if you can get them):
    Ask Andy/Tifani/Schyler to record a 15-30 second video
    of their reaction listening to their memflection.
    Upload to YouTube (unlisted) and embed below.

    OPTION C (Written quote card):
    Use the styled quote card below — just update the text.
    ══════════════════════════════════════════════════
    %>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; max-width: 900px; margin: 0 auto;">

      <%# PLACEHOLDER 1 — replace with real screenshot %>
      <div style="background: #fdf4ff; border: 2px dashed #d8b4fe; border-radius: 16px; padding: 2rem; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 200px;">
        <span style="font-size: 2rem; margin-bottom: 1rem;">📸</span>
        <p style="font-family: 'Lora', serif; font-size: 0.85rem; color: #7c3aed; text-transform: none; letter-spacing: normal; text-align: center; line-height: 1.6;">
          <strong>[ TESTIMONIAL 1 ]</strong><br>
          Add a WhatsApp/iMessage reaction screenshot<br>
          from Andy, Tifani, Schyler, or Dan.<br>
          See code comments above for instructions.
        </p>
      </div>

      <%# PLACEHOLDER 2 — replace with real screenshot %>
      <div style="background: #fff0f6; border: 2px dashed #fbcfe8; border-radius: 16px; padding: 2rem; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 200px;">
        <span style="font-size: 2rem; margin-bottom: 1rem;">💬</span>
        <p style="font-family: 'Lora', serif; font-size: 0.85rem; color: #be185d; text-transform: none; letter-spacing: normal; text-align: center; line-height: 1.6;">
          <strong>[ TESTIMONIAL 2 ]</strong><br>
          Or use a written quote card:<br>
          Replace this with a real quote and name.<br>
          See code comments above for instructions.
        </p>
      </div>

      <%# Example of a styled written quote — duplicate and fill in with real quotes %>
      <%#
      <div style="background: white; border: 1px solid #e9d5ff; border-radius: 16px; padding: 2rem; box-shadow: 0 4px 20px rgba(109,40,217,0.06); text-align: left;">
        <div style="font-size: 2rem; color: #d8b4fe; line-height: 1; margin-bottom: 1rem;">"</div>
        <p style="font-family: 'Lora', serif; font-size: 1rem; color: #3b0764; text-transform: none; letter-spacing: normal; line-height: 1.7; margin: 0 0 1.5rem; font-style: italic;">
          I ugly cried for like 20 minutes. I can't believe he made this for me.
        </p>
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <div style="width: 36px; height: 36px; background: linear-gradient(135deg, #7c3aed, #be185d); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-family: 'Bebas Neue', sans-serif; font-size: 0.9rem;">T</div>
          <div>
            <div style="font-family: 'Lora', serif; font-size: 0.85rem; font-weight: 600; color: #3b0764; text-transform: none; letter-spacing: normal;">Tifani</div>
            <div style="font-family: 'Lora', serif; font-size: 0.75rem; color: #a78bfa; text-transform: none; letter-spacing: normal;">Gift recipient</div>
          </div>
        </div>
      </div>
      %>
    </div>
  </section>

  <%# ══════════════════════════════════════════════════════════
      SECTION 7 — AUDIO SAMPLES (Gift-focused)
  ══════════════════════════════════════════════════════════ %>
  <section style="background: linear-gradient(160deg, #1e1b4b 0%, #2d1b69 100%); padding: 5rem 1.5rem; text-align: center;">
