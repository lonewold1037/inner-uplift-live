<script>
  function switchAudio(idx) {
    const tabs = document.querySelectorAll('[id^="audio-tab-"]');
    const audio = document.getElementById('sample-audio');
    const src   = document.getElementById('sample-src');
    const cap   = document.getElementById('sample-caption');
    const el    = document.getElementById('audio-tab-' + idx);
    tabs.forEach(t => { t.style.background = 'rgba(255,255,255,0.08)'; t.style.color = 'rgba(255,255,255,0.55)'; });
    el.style.background = '#c9a84c';
    el.style.color = '#1a0a2e';
    audio.pause();
    src.src = el.dataset.src;
    audio.load();
    cap.textContent = el.dataset.caption;
  }

  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
  }, { threshold: 0.1 });
  document.querySelectorAll('.scroll-reveal').forEach(el => obs.observe(el));

  window.addEventListener('load', () => {
    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;
    if (isStandalone || !isIOS) return;
    const b = document.createElement('div');
    b.style.cssText = 'position:fixed;top:0;left:0;right:0;background:#1a0a2e;color:white;padding:0.875rem 1.25rem;z-index:100;display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;box-shadow:0 4px 20px rgba(0,0,0,0.3);';
    b.innerHTML = '<p style="font-family:Lora,serif;font-size:0.85rem;text-transform:none;letter-spacing:normal;margin:0;line-height:1.5;opacity:0.9;">📱 Tap <strong>Share</strong> then <strong>Add to Home Screen</strong> to install Memflect</p><button onclick="this.parentNode.remove()" style="background:none;border:none;color:rgba(255,255,255,0.5);font-size:1.3rem;cursor:pointer;flex-shrink:0;padding:0;">✕</button>';
    document.body.prepend(b);
  });
</script>
