          </div>
        </div>
      </div>

      <!-- Secondary CTA -->
      <div class="mt-8 text-center">
        <%= link_to "Try a 30-Second Demo →", new_reflection_path, class: "inline-block bg-white/10 hover:bg-white/20 border border-white/20 hover:border-white/40 text-white font-medium tracking-wide text-lg py-4 px-10 rounded-xl transition-all duration-300" %>
      </div>

    </div><!-- end overflow-hidden wrapper -->
  </div>
