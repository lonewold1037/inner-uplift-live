    <script>
      const phrases = [
        "Built for real life by a real person",
        "Made for everyday reminiscent thinking",
        "For people who love nostalgia",
        "A place to collect your thoughts",
        "For moments that stick with you",
        "For memories worth keeping",
        "For busy people to help slow down",
        "For long days and quiet nights",
        "A nice supplement to journaling",
        "An app to transform valuable memories",
        "Your voice, your soundscape choice",
        "For things you don't want to forget",
        "For moments that mattered",
        "For figuring things out as you go",
        "Simple by design",
        "Private by default"
      ];
      
      let currentIndex = 0;
      const rotatingText = document.getElementById('rotating-text');
      
      function rotateText() {
        // Fade out
        rotatingText.style.opacity = '0';
        
        setTimeout(() => {
          // Change text
          currentIndex = (currentIndex + 1) % phrases.length;
          rotatingText.textContent = phrases[currentIndex];
          
          // Fade in
          rotatingText.style.opacity = '1';
        }, 700);
      }
      
      setInterval(rotateText, 4000);
    </script>

