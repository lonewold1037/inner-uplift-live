<%# ============================================================
    MEMFLECT — HOMEPAGE v3
    File: app/views/pages/home.html.erb

    TO SWAP THE CAMPAIGN VIDEO — change these 3 lines ONLY:
      campaign_video_id  = "YOUR_YOUTUBE_VIDEO_ID"
      campaign_label     = "Christmas — Dec 25"
      campaign_badge     = "🎄 Christmas is Dec 25 — order by Dec 20"
    That's it. No other changes needed anywhere.
    ============================================================ %>

<% campaign_video_id = "PHPOoJCdiII" %>
<% campaign_label    = "Mother's Day — May 11" %>
<% campaign_badge    = "💐 Mother's Day is May 11 — Create her gift now" %>

<% content_for :head do %>
  <style>
    .memflect-home * { box-sizing: border-box; }

    @keyframes bannerSlide {
      from { transform: translateY(-100%); opacity: 0; }
      to   { transform: translateY(0); opacity: 1; }
    }
    .campaign-banner { animation: bannerSlide 0.6s cubic-bezier(0.16,1,0.3,1) forwards; }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .reveal-1 { animation: fadeUp 0.8s ease forwards 0.1s; opacity: 0; }
    .reveal-2 { animation: fadeUp 0.8s ease forwards 0.3s; opacity: 0; }
    .reveal-3 { animation: fadeUp 0.8s ease forwards 0.5s; opacity: 0; }
    .reveal-4 { animation: fadeUp 0.8s ease forwards 0.7s; opacity: 0; }

    @keyframes shimmer {
      0%   { background-position: -200% center; }
      100% { background-position: 200% center; }
    }
    .gold-shimmer {
      background: linear-gradient(90deg, #c9a84c 0%, #f0d080 40%, #c9a84c 60%, #a07830 100%);
      background-size: 200% auto;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: shimmer 4s linear infinite;
    }

    .scroll-reveal {
      opacity: 0;
      transform: translateY(32px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .scroll-reveal.visible { opacity: 1; transform: translateY(0); }

    .video-wrapper {
      position: relative;
      padding-bottom: 56.25%;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 32px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(201,168,76,0.3);
    }
    .video-wrapper iframe {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      border: none;
    }

    .testimonial-card {
      background: white;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 4px 24px rgba(109,40,217,0.1);
      border: 1px solid rgba(109,40,217,0.08);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .testimonial-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(109,40,217,0.15);
    }

    @keyframes offerPulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(201,168,76,0.5); }
      50%       { box-shadow: 0 0 0 14px rgba(201,168,76,0); }
    }
    .offer-cta { animation: offerPulse 2.5s ease-in-out infinite; }

    @keyframes blobDrift {
      0%, 100% { transform: translate(0,0) scale(1); }
      33%       { transform: translate(30px,-40px) scale(1.06); }
      66%       { transform: translate(-20px,20px) scale(0.96); }
    }

    @media (max-width: 640px) {
      .hero-h1 { font-size: clamp(3rem, 13vw, 5.5rem) !important; }
      .two-col { grid-template-columns: 1fr !important; }
      .formula-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
  </style>
<% end %>

<script>
  document.body.classList.add('page-home');
  document.addEventListener('turbo:before-visit', () => document.body.classList.remove('page-home'));
</script>

<div class="memflect-home" style="font-family:'Lora',Georgia,serif;color:#1a0a2e;overflow-x:hidden;">

  <%# ── CAMPAIGN BANNER ── %>
  <div class="campaign-banner" style="background:linear-gradient(90deg,#1a0a2e 0%,#3b0764 50%,#1a0a2e 100%);padding:0.6rem 1.5rem;text-align:center;position:relative;z-index:40;">
    <p style="font-family:'Lora',serif;font-size:0.875rem;text-transform:none;letter-spacing:normal;margin:0;color:rgba(255,255,255,0.9);">
      <%= campaign_badge %>
      &nbsp;·&nbsp;
      <%= link_to "Create now →", new_reflection_path, style: "color:#f0d080;font-weight:600;text-decoration:none;" %>
    </p>
  </div>

  <%# ── HERO ── %>
  <section style="background:#faf7f2;padding:6rem 1.5rem 5rem;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;top:-120px;left:-120px;width:500px;height:500px;background:radial-gradient(circle,rgba(201,168,76,0.09) 0%,transparent 70%);animation:blobDrift 8s ease-in-out infinite;pointer-events:none;"></div>
    <div style="position:absolute;bottom:-80px;right:-80px;width:400px;height:400px;background:radial-gradient(circle,rgba(109,40,217,0.07) 0%,transparent 70%);animation:blobDrift 10s ease-in-out infinite 2s;pointer-events:none;"></div>

    <div style="max-width:820px;margin:0 auto;position:relative;z-index:1;">

      <div class="reveal-1" style="display:inline-flex;align-items:center;gap:0.5rem;background:white;border:1px solid rgba(201,168,76,0.4);border-radius:100px;padding:0.4rem 1.1rem;margin-bottom:2rem;box-shadow:0 2px 16px rgba(201,168,76,0.12);">
        <span style="font-size:0.85rem;color:#92400e;">✦</span>
        <span style="font-family:'Lora',serif;font-size:0.8rem;color:#92400e;text-transform:none;letter-spacing:normal;font-style:italic;">The eCard industry hasn't changed since 2003.</span>
      </div>

      <h1 class="hero-h1 reveal-2" style="font-family:'Bebas Neue',sans-serif;font-size:clamp(3.5rem,10vw,7rem);line-height:0.92;letter-spacing:0.02em;color:#1a0a2e;margin:0 0 0.4rem;">
        Memflect
        <span class="gold-shimmer" style="display:block;">Revolutionised</span>
        the Gift.
      </h1>

      <p class="reveal-3" style="font-size:clamp(1rem,2.5vw,1.2rem);color:#6b4f3a;line-height:1.8;max-width:600px;margin:1.75rem auto 2.5rem;text-transform:none;letter-spacing:normal;font-style:italic;">
        Your phone has 10,000 photos that say nothing. Social media is noise. eCards are embarrassing. The people you love deserve a moment — narrated in your own voice, set to music, delivered as a cinematic reveal they'll never delete.
      </p>

      <div class="reveal-4" style="display:flex;flex-wrap:wrap;gap:1rem;justify-content:center;align-items:center;">
        <%= link_to new_reflection_path,
              style: "display:inline-block;background:linear-gradient(135deg,#1a0a2e 0%,#3b0764 100%);color:white;font-family:'Bebas Neue',sans-serif;font-size:1.3rem;letter-spacing:0.1em;padding:1.1rem 2.75rem;border-radius:100px;text-decoration:none;box-shadow:0 8px 32px rgba(26,10,46,0.3);transition:transform 0.2s,box-shadow 0.2s;",
              onmouseover: "this.style.transform='scale(1.03)';this.style.boxShadow='0 14px 40px rgba(26,10,46,0.4)'",
              onmouseout:  "this.style.transform='scale(1)';this.style.boxShadow='0 8px 32px rgba(26,10,46,0.3)'" do %>
          Create a Gift — $3.99
        <% end %>
        <span style="font-family:'Lora',serif;font-size:0.85rem;color:#a78bfa;text-transform:none;letter-spacing:normal;font-style:italic;">Less than a coffee. Remembered forever.</span>
      </div>

    </div>
  </section>

  <%# ── CAMPAIGN VIDEO ── %>
  <section class="scroll-reveal" style="background:#1a0a2e;padding:5rem 1.5rem;text-align:center;">
    <div style="max-width:800px;margin:0 auto;">

      <div style="display:inline-flex;align-items:center;gap:0.5rem;background:rgba(201,168,76,0.15);border:1px solid rgba(201,168,76,0.3);border-radius:100px;padding:0.4rem 1.1rem;margin-bottom:1.5rem;">
        <span style="font-size:0.85rem;">🎬</span>
        <span style="font-family:'Bebas Neue',sans-serif;font-size:0.8rem;letter-spacing:0.12em;color:#f0d080;"><%= campaign_label %></span>
      </div>

      <h2 style="font-family:'Bebas Neue',sans-serif;font-size:clamp(2rem,6vw,3.5rem);letter-spacing:0.04em;color:white;margin:0 0 0.75rem;">
        This is what $3.99 feels like.
      </h2>
      <p style="font-family:'Lora',serif;font-size:1rem;color:rgba(255,255,255,0.5);text-transform:none;letter-spacing:normal;margin:0 0 2.5rem;font-style:italic;">
        Watch the full story — then decide.
      </p>

      <div class="video-wrapper">
        <iframe
          src="https://www.youtube.com/embed/<%= campaign_video_id %>?rel=0&modestbranding=1"
          title="<%= campaign_label %> — Memflect"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen>
        </iframe>
      </div>

      <%#
      ════════════════════════════════════════════
      📹 SWAP THIS VIDEO IN 3 STEPS:
      1. Upload your new video to YouTube
      2. Copy the video ID (e.g. "dQw4w9WgXcQ")
      3. Change campaign_video_id at the TOP of this file
      Done. The badge and label update automatically too.
      ════════════════════════════════════════════
      %>

    </div>
  </section>

  <%# ── FORMULA ── %>
  <section class="scroll-reveal" style="background:#faf7f2;padding:5rem 1.5rem;text-align:center;">
    <div style="max-width:920px;margin:0 auto;">

      <p style="font-family:'Bebas Neue',sans-serif;font-size:0.8rem;letter-spacing:0.2em;color:#c9a84c;margin:0 0 1rem;">THE FORMULA</p>
      <h2 style="font-family:'Bebas Neue',sans-serif;font-size:clamp(2rem,6vw,3.5rem);letter-spacing:0.03em;color:#1a0a2e;margin:0 0 3rem;">Four ingredients. One unforgettable gift.</h2>

      <div class="formula-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem;margin-bottom:2.5rem;">
        <% [
          ["📸", "Their Photo",    "The moment that matters",          "#fdf4ff", "rgba(109,40,217,0.15)"],
          ["🎤", "Your Voice",     "Cloned by AI — unmistakably you",  "#fff0f6", "rgba(244,114,182,0.15)"],
          ["🎵", "Sweet Music",    "You choose the soundscape",        "#f0fdf4", "rgba(34,197,94,0.15)"],
          ["✨", "Memflect Magic", "5 cinematic minutes",              "#fffbeb", "rgba(201,168,76,0.25)"]
        ].each do |emoji, title, desc, bg, border| %>
          <div style="background:<%= bg %>;border:1.5px solid <%= border %>;border-radius:20px;padding:1.75rem 1rem;text-align:center;">
            <div style="font-size:2.25rem;margin-bottom:0.75rem;"><%= emoji %></div>
            <p style="font-family:'Bebas Neue',sans-serif;font-size:0.95rem;letter-spacing:0.06em;color:#1a0a2e;margin:0 0 0.35rem;"><%= title %></p>
            <p style="font-family:'Lora',serif;font-size:0.78rem;color:#6b4f3a;text-transform:none;letter-spacing:normal;margin:0;font-style:italic;line-height:1.5;"><%= desc %></p>
          </div>
        <% end %>
      </div>

      <div style="display:inline-flex;align-items:center;gap:1rem;background:#1a0a2e;border-radius:100px;padding:1rem 2rem;">
        <span style="font-family:'Bebas Neue',sans-serif;font-size:1.2rem;letter-spacing:0.1em;color:rgba(255,255,255,0.4);">=</span>
        <span style="font-size:1.5rem;">🎁</span>
        <span style="font-family:'Lora',serif;font-size:0.95rem;color:#f0d080;text-transform:none;letter-spacing:normal;font-style:italic;">A gift they'll cry over</span>
      </div>

    </div>
  </section>

  <%# ── TESTIMONIALS ── %>
  <section class="scroll-reveal" style="background:white;padding:5rem 1.5rem;">
    <div style="max-width:960px;margin:0 auto;">

      <div style="text-align:center;margin-bottom:3rem;">
        <p style="font-family:'Bebas Neue',sans-serif;font-size:0.8rem;letter-spacing:0.2em;color:#c9a84c;margin:0 0 0.75rem;">REAL REACTIONS</p>
        <h2 style="font-family:'Bebas Neue',sans-serif;font-size:clamp(2rem,6vw,3rem);letter-spacing:0.03em;color:#1a0a2e;margin:0;">
          They didn't expect it to hit this hard.
        </h2>
      </div>

      <div class="two-col" style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:2.5rem;">
        <%#
        ════════════════════════════════════════════
        📸 TESTIMONIALS — drop real screenshots here.
        Replace each placeholder div below with:
        <div class="testimonial-card">
          <img src="/images/testimonials/t1.png"
               alt="Customer reaction"
               style="width:100%;display:block;">
        </div>
        You have t1.png → t4.png in public/images/testimonials/
        ════════════════════════════════════════════
        %>
        <% %w[t1.png t2.png].each do |f| %>
          <% if File.exist?(Rails.root.join("public/images/testimonials/#{f}")) %>
            <div class="testimonial-card">
              <img src="/images/testimonials/<%= f %>" alt="Customer reaction" style="width:100%;display:block;border-radius:16px;">
            </div>
          <% else %>
            <div class="testimonial-card" style="padding:2.5rem;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:200px;background:#faf7f2;border:2px dashed rgba(201,168,76,0.3);">
              <p style="font-size:1.75rem;margin:0 0 0.75rem;">📸</p>
              <p style="font-family:'Lora',serif;font-size:0.85rem;color:#a78bfa;text-transform:none;letter-spacing:normal;text-align:center;margin:0;font-style:italic;">Drop a reaction screenshot here — see comments in code above.</p>
            </div>
          <% end %>
        <% end %>
      </div>

      <%# Audio samples %>
      <div style="background:#1a0a2e;border-radius:24px;padding:2.5rem;text-align:center;">
        <p style="font-family:'Bebas Neue',sans-serif;font-size:0.8rem;letter-spacing:0.2em;color:#f0d080;margin:0 0 0.75rem;">HEAR A REAL MEMFLECTION</p>
        <h3 style="font-family:'Bebas Neue',sans-serif;font-size:1.8rem;letter-spacing:0.04em;color:white;margin:0 0 1.75rem;">Gift mode. Real voice. Real tears.</h3>

        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.5rem;margin-bottom:1.25rem;max-width:560px;margin-left:auto;margin-right:auto;">
          <% [
            ["🌼", "Dandelion",  0, "/audio/homepage-sample-3.mp3", "A son's memory of giving his mom a flower, now a father's lesson"],
            ["🌙", "Stillness",  1, "/audio/homepage-sample-4.mp3", "Gift: sent to someone not alone in depression"],
            ["🏈", "Seahawks",   2, "/audio/homepage-sample-6.mp3", "Gift: a 12th Man's cinematic letter to the Seahawks"]
          ].each_with_index do |(emoji, name, idx, src, cap), i| %>
            <button onclick="switchAudio(<%= idx %>)"
                    id="audio-tab-<%= idx %>"
                    data-src="<%= src %>"
                    data-caption="<%= cap %>"
                    style="<%= i == 0 ? 'background:#c9a84c;color:#1a0a2e;' : 'background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.55);' %>border:none;border-radius:12px;padding:0.625rem 0.4rem;font-family:'Lora',serif;font-size:0.75rem;text-transform:none;letter-spacing:normal;cursor:pointer;line-height:1.4;transition:all 0.2s;">
              <%= emoji %><br><%= name %>
            </button>
          <% end %>
        </div>

        <audio id="sample-audio" controls preload="metadata" style="width:100%;max-width:560px;border-radius:10px;display:block;margin:0 auto;">
          <source id="sample-src" src="/audio/homepage-sample-3.mp3" type="audio/mpeg">
        </audio>
        <p id="sample-caption" style="font-family:'Lora',serif;font-size:0.78rem;color:rgba(255,255,255,0.3);text-transform:none;letter-spacing:normal;margin:0.75rem 0 0;font-style:italic;">
          A son's memory of giving his mom a flower, now a father's lesson
        </p>
      </div>

    </div>
  </section>

  <%# ── THE OFFER ── %>
  <section class="scroll-reveal" style="background:linear-gradient(160deg,#1a0a2e 0%,#2d1060 50%,#1a0a2e 100%);padding:6rem 1.5rem;text-align:center;position:relative;overflow:hidden;">
    <div style="max-width:700px;margin:0 auto;position:relative;z-index:1;">

      <p style="font-family:'Bebas Neue',sans-serif;font-size:0.8rem;letter-spacing:0.2em;color:#c9a84c;margin:0 0 1.5rem;">THE OFFER</p>

      <h2 style="font-family:'Bebas Neue',sans-serif;font-size:clamp(2.2rem,7vw,4rem);letter-spacing:0.03em;color:white;margin:0 0 1.5rem;line-height:1.05;">
        Done sending gifts<br>
        <span class="gold-shimmer">that vanish in 24 hours?</span>
      </h2>

      <p style="font-family:'Lora',serif;font-size:1.05rem;color:rgba(255,255,255,0.65);text-transform:none;letter-spacing:normal;line-height:1.85;margin:0 0 2rem;font-style:italic;">
        Try Memflect free. Fill in 4 fields about a memory. Record your voice reading a short script. We'll mix it into a 30-second cinematic preview — at no charge. If it moves you, unlock the full 5-minute version for $3.99. No subscription. No monthly fee. Yours to keep forever.
      </p>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:2.5rem;max-width:460px;margin-left:auto;margin-right:auto;">
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:1.25rem;">
          <p style="font-family:'Bebas Neue',sans-serif;font-size:0.7rem;letter-spacing:0.15em;color:rgba(255,255,255,0.35);margin:0 0 0.35rem;">MONTHLY APPS</p>
          <p style="font-family:'Bebas Neue',sans-serif;font-size:2rem;letter-spacing:0.04em;color:rgba(255,255,255,0.25);margin:0;text-decoration:line-through;">$9.99/mo</p>
          <p style="font-family:'Lora',serif;font-size:0.75rem;color:rgba(255,255,255,0.25);text-transform:none;letter-spacing:normal;margin:0.25rem 0 0;font-style:italic;">Generic. Forgettable.</p>
        </div>
        <div style="background:rgba(201,168,76,0.1);border:1.5px solid rgba(201,168,76,0.4);border-radius:16px;padding:1.25rem;">
          <p style="font-family:'Bebas Neue',sans-serif;font-size:0.7rem;letter-spacing:0.15em;color:#f0d080;margin:0 0 0.35rem;">MEMFLECT</p>
          <p style="font-family:'Bebas Neue',sans-serif;font-size:2rem;letter-spacing:0.04em;color:#f0d080;margin:0;">$3.99</p>
          <p style="font-family:'Lora',serif;font-size:0.75rem;color:#f0d080;text-transform:none;letter-spacing:normal;margin:0.25rem 0 0;font-style:italic;opacity:0.8;">Personal. Remembered forever.</p>
        </div>
      </div>

      <%= link_to new_reflection_path,
            class: "offer-cta",
            style: "display:inline-block;background:linear-gradient(135deg,#c9a84c 0%,#f0d080 50%,#c9a84c 100%);color:#1a0a2e;font-family:'Bebas Neue',sans-serif;font-size:1.3rem;letter-spacing:0.1em;padding:1.2rem 3rem;border-radius:100px;text-decoration:none;font-weight:700;" do %>
        Try Free — Download My 30-Second Sample
      <% end %>

      <p style="font-family:'Lora',serif;font-size:0.8rem;color:rgba(255,255,255,0.3);text-transform:none;letter-spacing:normal;margin:1rem 0 0;font-style:italic;">
        Free preview. No card required. $3.99 only if you love it.
      </p>

    </div>
  </section>

  <%# ── OCCASIONS ── %>
  <section class="scroll-reveal" style="background:#faf7f2;padding:3.5rem 1.5rem;text-align:center;">
    <p style="font-family:'Bebas Neue',sans-serif;font-size:0.75rem;letter-spacing:0.2em;color:#c9a84c;margin:0 0 1.5rem;">PERFECT FOR EVERY OCCASION</p>
    <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:0.6rem;max-width:700px;margin:0 auto;">
      <% [["💐","Mother's Day"],["🎂","Birthdays"],["💍","Anniversaries"],["🎓","Graduations"],["💛","Just Because"],["🙏","Thank You"],["💔","Grief & Loss"],["🎄","Christmas"],["🎖️","Veterans Day"],["🏆","Achievements"]].each do |emoji, label| %>
        <div style="display:inline-flex;align-items:center;gap:0.4rem;background:white;border:1px solid rgba(201,168,76,0.25);border-radius:100px;padding:0.45rem 0.875rem;box-shadow:0 2px 8px rgba(26,10,46,0.05);">
          <span style="font-size:0.95rem;"><%= emoji %></span>
          <span style="font-family:'Lora',serif;font-size:0.8rem;color:#3b0764;text-transform:none;letter-spacing:normal;font-weight:600;"><%= label %></span>
        </div>
      <% end %>
    </div>
  </section>

  <%# ── FOUNDER NOTE ── %>
  <section class="scroll-reveal" style="background:white;padding:5rem 1.5rem;">
    <div style="max-width:620px;margin:0 auto;text-align:center;">

      <%#
      📸 FOUNDER PHOTO — already at /images/ryan-headshot.png
      To use a different photo, update the src below.
      %>
      <img src="/images/ryan-headshot.png"
           alt="Ryan McLeod, creator of Memflect"
           style="width:100px;height:130px;border-radius:20px;object-fit:cover;border:3px solid rgba(201,168,76,0.3);box-shadow:0 8px 32px rgba(26,10,46,0.1);margin-bottom:1.75rem;display:inline-block;">

      <p style="font-family:'Bebas Neue',sans-serif;font-size:0.7rem;letter-spacing:0.18em;color:#92400e;margin:0 0 1.25rem;">✦ A WORD FROM THE FOUNDER</p>

      <blockquote style="font-family:'Lora',serif;font-size:1.1rem;color:#3b0764;text-transform:none;letter-spacing:normal;line-height:1.9;margin:0 0 1.5rem;font-style:italic;">
        "I built Memflect because journaling never worked for me — but talking out loud did. I'm a stay-at-home dad in Singapore, 8 months into coding, and this is my first app. I built it for myself, then realised it was the most personal gift I'd ever made for someone I love. For $3.99, you can give someone a piece of you that no flower or gift card ever could."
      </blockquote>

      <p style="font-family:'Bebas Neue',sans-serif;font-size:0.85rem;letter-spacing:0.1em;color:#c9a84c;margin:0;">
        Ryan McLeod &nbsp;·&nbsp; Self-taught dev &nbsp;·&nbsp; Stay-at-home dad &nbsp;·&nbsp; Singapore
      </p>

