<%# ============================================================
    SECTION: CAMPAIGN VIDEO
    File: app/views/pages/_section_video.html.erb

    This section is commented out in home.html.erb by default.
    To enable: change <%#= to <%= on the render line in home.html.erb

    TO SWAP THE VIDEO:
    Change campaign_video_id below to any YouTube video ID.
    ============================================================ %>

<% campaign_video_id    = "PHPOoJCdiII" %>
<% campaign_video_label = "Father's Day — June 15" %>

<section class="scroll-reveal" style="background: #1a0a2e; padding: 5rem 1.5rem; text-align: center;">
  <div style="max-width: 800px; margin: 0 auto;">

    <p style="font-family: 'Bebas Neue', sans-serif; font-size: 0.8rem; letter-spacing: 0.2em; color: #f0d080; margin: 0 0 1rem;"><%= campaign_video_label %></p>
    <h2 style="font-family: 'Bebas Neue', sans-serif; font-size: clamp(2rem, 6vw, 3rem); letter-spacing: 0.04em; color: white; margin: 0 0 2.5rem;">
      See what a Memflection feels like.
    </h2>

    <div style="position: relative; padding-bottom: 56.25%; border-radius: 20px; overflow: hidden; box-shadow: 0 32px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(201,168,76,0.3);">
      <iframe
        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;"
        src="https://www.youtube.com/embed/<%= campaign_video_id %>?rel=0&modestbranding=1"
        title="<%= campaign_video_label %> — Memflect"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen>
      </iframe>
    </div>

  </div>
</section>
