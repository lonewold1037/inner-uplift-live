<!DOCTYPE html>
<html>
<head>
  <title>Memflect</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- PWA Meta Tags -->
  <meta name="theme-color" content="#ffffff">

  <!-- Vite Asset Tags -->
  <%= vite_client_tag %>
  <%= vite_javascript_tag 'application' %>
  <%= vite_stylesheet_tag 'application' %>
</head>

<body class="bg-gradient-to-br from-sky-400 to-sky-500 font-sans">
  <header class="bg-white/10 backdrop-blur-sm shadow">
    <nav class="container mx-auto px-6 py-3 flex justify-between items-center">
      <div>
        <%= link_to "Memflect", root_path, class: "text-2xl font-bold text-white" %>
      </div>
      <div class="flex items-center space-x-4">
        <% if user_signed_in? %>
          <%= link_to "Dashboard", dashboard_path, class: "text-white hover:text-gray-200" %>
          <%= button_to "Log Out", destroy_user_session_path, method: :delete, class: "text-white hover:text-gray-200" %>
        <% else %>
          <%= link_to "Log In", new_user_session_path, class: "text-white hover:text-gray-200" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "bg-sky-600 hover:bg-sky-500 text-white font-bold py-2 px-4 rounded-lg" %>
        <% end %>
      </div>
    </nav>
  </header>

  <main>
    <%= yield %>
  </main>

  <footer class="bg-white/10 backdrop-blur-sm mt-16 py-6">
    <div class="container mx-auto px-6 text-center">
      <div class="flex justify-center space-x-6 text-sm text-white/80">
        <%= link_to "Privacy Policy", privacy_path, class: "hover:text-white" %>
        <span>•</span>
        <%= link_to "Terms of Service", terms_path, class: "hover:text-white" %>
        <span>•</span>
        <a href="mailto:support@memflect.com" class="hover:text-white">Contact</a>
      </div>
      <p class="mt-2 text-xs text-white/60">© <%= Date.current.year %> Memflect. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>