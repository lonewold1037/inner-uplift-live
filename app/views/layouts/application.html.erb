<head>
  <title>Memflect</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Text:wght@400;600&family=Spectral:wght@300;400&family=Lora:wght@400;500&family=Merriweather:wght@300&family=EB+Garamond&display=swap" rel="stylesheet">
  
  <!-- WaveSurfer.js for beautiful audio players -->
  <script src="https://unpkg.com/wavesurfer.js@7"></script>

  <!-- PWA Meta Tags -->
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- PWA Meta Tags -->
  <meta name="theme-color" content="#0ea5e9">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Memflect">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/icon-512.png">

  <!-- Vite Asset Tags -->
  <%= vite_client_tag %>
  <%= vite_javascript_tag 'application' %>
  <%= vite_stylesheet_tag 'application' %>
</head>

<body class="font-sans">
  <!-- Gradient Mesh Background - GLOBAL -->
  <div class="fixed inset-0 -z-10 overflow-hidden bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900">
    <div class="absolute top-0 -left-4 w-72 h-72 bg-purple-500 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob"></div>
    <div class="absolute top-0 -right-4 w-72 h-72 bg-yellow-500 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob animation-delay-2000"></div>
    <div class="absolute -bottom-8 left-20 w-72 h-72 bg-pink-500 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob animation-delay-4000"></div>
  </div>

  <header class="bg-white/10 backdrop-blur-sm shadow relative z-50">
    <nav class="container mx-auto px-6 py-3 flex justify-between items-center">
      
      <div>
        <%= link_to "Memflect", root_path, class: "text-2xl font-bold tracking-wider text-white" %>
      </div>
      
      <div class="flex items-center gap-4">
        <% if user_signed_in? %>
          <%= link_to "Dashboard", dashboard_path, class: "text-white hover:text-sky-400 font-medium transition-colors text-sm uppercase tracking-wide" %>
          <%= button_to "Log Out", destroy_user_session_path, method: :delete, data: { turbo: false }, class: "text-slate-400 hover:text-white text-sm uppercase tracking-wide cursor-pointer" %>
        <% else %>
          <%= link_to "Log In", new_user_session_path, class: "text-white hover:text-sky-400 font-medium text-sm uppercase tracking-wide" %>
        <% end %>
      </div>

    </nav>
  </header>

  <main>
    <%= yield %>
  </main>

  <footer class="bg-white/10 backdrop-blur-sm mt-4 py-6 relative z-10">
    <div class="container mx-auto px-6 text-center">
      <div class="flex justify-center space-x-6 text-sm text-white/80">
        <%= link_to "Privacy Policy", privacy_path, class: "hover:text-white" %>
        <span>•</span>
        <%= link_to "Terms of Service", terms_path, class: "hover:text-white" %>
        <span>•</span>
        <a href="mailto:ryan@memflect.com" class="hover:text-white">Contact</a>
      </div>
      <p class="mt-2 text-xs text-white/60">© <%= Date.current.year %> Memflect. All rights reserved.</p>
    </div>
  </footer>

  <!-- Gradient Mesh Animation Styles -->
  <style>
    @keyframes blob {
      0%, 100% { 
        transform: translate(0px, 0px) scale(1); 
      }
      33% { 
        transform: translate(30px, -50px) scale(1.1); 
      }
      66% { 
        transform: translate(-20px, 20px) scale(0.9); 
      }
    }
    
    .animate-blob {
      animation: blob 7s infinite;
    }
    
    .animation-delay-2000 {
      animation-delay: 2s;
    }
    
    .animation-delay-4000 {
      animation-delay: 4s;
    }
  </style>

  <% unless cookies[:cookie_consent] %>
    <div id="cookie-banner" style="position: fixed; bottom: 0; left: 0; right: 0; background: rgba(26, 26, 46, 0.98); backdrop-filter: blur(10px); color: white; padding: 20px; text-align: center; z-index: 9999; border-top: 2px solid rgba(139, 92, 246, 0.5); box-shadow: 0 -4px 20px rgba(0,0,0,0.3);">
      <div style="max-width: 800px; margin: 0 auto;">
        <p style="margin: 0 0 15px 0; font-size: 14px; color: #cbd5e1;">
          We use essential cookies to make Memflect work. By continuing, you accept our 
          <%= link_to "Privacy Policy", privacy_path, style: "color: #38bdf8; text-decoration: underline; font-weight: 600;" %>.
        </p>
        <%= button_to "Accept & Continue", accept_cookies_path, method: :post, style: "background: linear-gradient(135deg, #8b5cf6 0%, #ec4899 100%); color: white; border: none; padding: 12px 40px; border-radius: 50px; cursor: pointer; font-weight: bold; font-size: 14px; box-shadow: 0 4px 15px rgba(139, 92, 246, 0.4); transition: transform 0.2s;" %>
      </div>
    </div>
  <% end %>
  
</body>
</html>
