<div class="min-h-screen flex items-center justify-center px-4 py-12">
  <div class="max-w-md w-full space-y-8 bg-black/50 backdrop-blur-xl p-8 rounded-2xl shadow-lg border border-white/20">
    
    <div class="text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white">Welcome Back</h2>
      <p class="mt-2 text-sm text-slate-400">Enter your email to sign in.</p>
    </div>

    <%= form_with(scope: resource_name, url: user_magic_link_path, local: true, class: "mt-8 space-y-6") do |f| %>
      
      <div>
        <%= f.label :email, class: "sr-only" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com", 
            class: "appearance-none relative block w-full px-3 py-3 border border-white/20 bg-white/5 placeholder-slate-500 text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 focus:z-10 sm:text-sm" %>
      </div>

      <div>
        <%= f.submit "✨ Send Me a Login Link", 
            class: "cursor-pointer group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-bold rounded-lg text-white bg-sky-600 hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-500 transition-colors" %>
      </div>
      
    <% end %>

    <div class="text-center mt-6 space-y-2">
       <p class="text-sm text-slate-400">
         New here? <%= link_to "Create an account", new_registration_path(resource_name), class: "text-sky-400 hover:text-sky-300 font-medium" %>
       </p>
       <%= link_to "← Back Home", root_path, class: "text-xs text-slate-500 hover:text-white" %>
    </div>

  </div>
</div>