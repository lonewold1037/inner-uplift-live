<div class="min-h-screen flex items-center justify-center p-8">
  <div class="max-w-md w-full bg-white/10 backdrop-blur-sm rounded-2xl shadow-2xl p-8">
    <h2 class="text-4xl font-bold tracking-wider text-white text-center mb-8">LOG IN</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-6">
        <%= f.label :email, class: "block text-white font-medium tracking-wide mb-2" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-3 rounded-lg bg-white/20 text-white placeholder-white/60 border border-white/30 focus:outline-none focus:ring-2 focus:ring-sky-500" %>
      </div>

      <div class="mb-6">
        <%= f.label :password, class: "block text-white font-medium tracking-wide mb-2" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "w-full px-4 py-3 rounded-lg bg-white/20 text-white placeholder-white/60 border border-white/30 focus:outline-none focus:ring-2 focus:ring-sky-500" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="mb-6 flex items-center">
          <%= f.check_box :remember_me, class: "mr-2" %>
          <%= f.label :remember_me, class: "text-white font-normal tracking-wide" %>
        </div>
      <% end %>

      <div class="mb-6">
        <%= f.submit "Log in", class: "w-full bg-gradient-to-r from-sky-600 to-blue-600 hover:from-sky-500 hover:to-blue-500 text-white font-medium tracking-widest py-3 px-6 rounded-xl shadow-lg transform hover:scale-105 transition-all duration-300 cursor-pointer" %>
      </div>
    <% end %>

    <div class="text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
