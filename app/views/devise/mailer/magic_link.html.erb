<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin: 0; padding: 0; background-color: #fdf6ff; font-family: Georgia, serif;">

  <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #fdf6ff; padding: 40px 20px;">
    <tr>
      <td align="center">
        <table width="100%" cellpadding="0" cellspacing="0" style="max-width: 520px;">

          <%# Logo %>
          <tr>
            <td align="center" style="padding-bottom: 24px;">
              <span style="font-family: Arial, sans-serif; font-size: 28px; font-weight: bold; letter-spacing: 6px; color: #6d28d9;">MEMFLECT</span>
            </td>
          </tr>

          <%# Card %>
          <tr>
            <td style="background-color: #ffffff; border-radius: 16px; padding: 40px 36px; border: 1px solid rgba(109,40,217,0.12); box-shadow: 0 4px 24px rgba(109,40,217,0.08);">

              <p style="font-size: 22px; font-weight: bold; color: #3b0764; margin: 0 0 8px; font-family: Arial, sans-serif; letter-spacing: 1px;">
                Your login link ✨
              </p>

              <p style="font-size: 15px; color: #6d28d9; margin: 0 0 28px; line-height: 1.7;">
                You requested a secure sign-in link for <strong><%= @resource.email %></strong>. Tap the button below to access your dashboard instantly — no password needed.
              </p>

              <%# CTA button %>
              <table cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 28px;">
                <tr>
                  <td align="center">
                    <%= link_to "Log In to Memflect",
                          user_magic_link_url(user: { email: @resource.email, token: @token }),
                          style: "display: inline-block; background: linear-gradient(135deg, #7c3aed 0%, #be185d 100%); color: #ffffff; font-family: Arial, sans-serif; font-size: 15px; font-weight: bold; letter-spacing: 2px; text-decoration: none; padding: 16px 40px; border-radius: 100px;" %>
                  </td>
                </tr>
              </table>

              <p style="font-size: 13px; color: #a78bfa; margin: 0 0 16px; text-align: center;">
                This link expires in 20 minutes.
              </p>

              <p style="font-size: 12px; color: #c4b5fd; line-height: 1.6; margin: 0; border-top: 1px solid rgba(109,40,217,0.08); padding-top: 16px;">
                If you didn't request this login link, you can safely ignore this email.
              </p>

            </td>
          </tr>

          <%# Footer %>
          <tr>
            <td align="center" style="padding-top: 24px;">
              <p style="font-size: 11px; color: #c4b5fd; margin: 0; font-family: Arial, sans-serif; letter-spacing: 1px;">
                © <%= Date.current.year %> MEMFLECT · <a href="https://memflect.com" style="color: #a78bfa; text-decoration: none;">memflect.com</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
