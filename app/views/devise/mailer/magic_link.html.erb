<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin: 0; padding: 0; background-color: #1a1a2e; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #1a1a2e; padding: 40px 20px;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="max-width: 600px; background: linear-gradient(180deg, #2d2d44 0%, #1a1a2e 100%); border-radius: 24px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1);">
          
          <tr>
            <td style="padding: 50px 40px 30px 40px; text-align: center;">
              <h1 style="margin: 0; font-size: 32px; font-weight: 700; color: #fcd34d; text-transform: uppercase; letter-spacing: 0.1em;">MEMFLECT</h1>
            </td>
          </tr>
          
          <tr>
            <td style="padding: 20px 40px 40px 40px; text-align: center;">
              <p style="color: #e2e8f0; font-size: 24px; font-weight: 600; margin: 0 0 20px 0;">Here is your login link ✨</p>
              
              <p style="color: #cbd5e1; font-size: 16px; line-height: 1.6; margin: 0 0 30px 0;">
                You requested a secure sign-in link for <strong><%= @resource.email %></strong>. Click the button below to access your dashboard instantly.
              </p>
              
              <table cellpadding="0" cellspacing="0" style="margin: 0 auto;">
                <tr>
                  <td style="background: linear-gradient(135deg, #8b5cf6 0%, #ec4899 100%); border-radius: 50px; box-shadow: 0 8px 30px rgba(139, 92, 246, 0.4); border: 2px solid rgba(255,255,255,0.3);">
                    <%= link_to "Log In to Memflect", user_magic_link_url(user: {email: @resource.email, token: @token}), style: "display: inline-block; padding: 16px 40px; color: #ffffff; font-size: 16px; font-weight: 700; text-decoration: none;" %>
                  </td>
                </tr>
              </table>

              <p style="color: #64748b; font-size: 14px; margin-top: 30px;">
                (This link will expire in 20 minutes)
              </p>
            </td>
          </tr>
          
          <tr>
            <td style="padding: 25px 40px; border-top: 1px solid rgba(255,255,255,0.1); text-align: center;">
              <p style="color: #64748b; font-size: 12px; margin: 0;">
                If you didn't request this, you can safely ignore this email.<br>
                © <%= Date.current.year %> Memflect
              </p>
            </td>
          </tr>
          
        </table>
      </td>
    </tr>
  </table>
</body>
</html>