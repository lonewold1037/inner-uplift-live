<div style="display: flex; flex-direction: column; gap: 0.5rem; align-items: center;">
  <%- if controller_name != 'sessions' %>
    <%= link_to "Log in", new_session_path(resource_name),
          style: "font-family: 'Lora', serif; font-size: 0.875rem; color: #7c3aed; text-transform: none; letter-spacing: normal; text-decoration: none;" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "Forgot your password?", new_password_path(resource_name),
          style: "font-family: 'Lora', serif; font-size: 0.875rem; color: #a78bfa; text-transform: none; letter-spacing: normal; text-decoration: none;" %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name),
          style: "font-family: 'Lora', serif; font-size: 0.875rem; color: #a78bfa; text-transform: none; letter-spacing: normal; text-decoration: none;" %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to "Didn't receive unlock instructions?", new_unlock_path(resource_name),
          style: "font-family: 'Lora', serif; font-size: 0.875rem; color: #a78bfa; text-transform: none; letter-spacing: normal; text-decoration: none;" %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "Sign in with #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider),
            data: { turbo: false },
            style: "background: none; border: none; font-family: 'Lora', serif; font-size: 0.875rem; color: #7c3aed; text-transform: none; letter-spacing: normal; cursor: pointer; padding: 0;" %>
    <% end %>
  <% end %>
</div>
